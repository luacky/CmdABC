#!/usr/bin/env bash

# CmdABC runtime. It reads CommandLibrary and prints a selected command;
# it never evaluates or executes library commands.

CMDABC_SOURCE_DIR=$(cd "${BASH_SOURCE[0]%/*}" && pwd)
CMDABC_VERSION_FILE=$CMDABC_SOURCE_DIR/VERSION
if [ ! -r "$CMDABC_VERSION_FILE" ]; then
  CMDABC_VERSION_FILE=$CMDABC_SOURCE_DIR/../VERSION
fi
CMDABC_VERSION=''
if [ -r "$CMDABC_VERSION_FILE" ]; then
  IFS= read -r CMDABC_VERSION < "$CMDABC_VERSION_FILE" || CMDABC_VERSION=''
fi
unset CMDABC_SOURCE_DIR CMDABC_VERSION_FILE

cmdabc_usage() {
  cat <<'EOF'
CmdABC 0.1

Usage:
  cmdabc validate --library FILE
  cmdabc children --library FILE --path PATH
  cmdabc pick --library FILE --namespace NAME
  cmdabc manage --library FILE --input LINE
EOF
}

cmdabc_error() {
  printf 'cmdabc: %s\n' "$*" >&2
}

cmdabc_parse_args() {
  CMDABC_LIBRARY_ARG=${CMDABC_LIBRARY:-}
  if [ -z "$CMDABC_LIBRARY_ARG" ] && [ -n "${HOME:-}" ]; then
    CMDABC_LIBRARY_ARG=$HOME/.cmdabc-data/command-library.txt
  fi
  CMDABC_PATH_ARG=""
  CMDABC_NAMESPACE_ARG=""
  CMDABC_INPUT_ARG=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --library)
        [ "$#" -ge 2 ] || { cmdabc_error "--library requires a file"; return 2; }
        CMDABC_LIBRARY_ARG=$2
        shift 2
        ;;
      --path)
        [ "$#" -ge 2 ] || { cmdabc_error "--path requires a value"; return 2; }
        CMDABC_PATH_ARG=$2
        shift 2
        ;;
      --namespace)
        [ "$#" -ge 2 ] || { cmdabc_error "--namespace requires a value"; return 2; }
        CMDABC_NAMESPACE_ARG=$2
        shift 2
        ;;
      --input)
        [ "$#" -ge 2 ] || { cmdabc_error "--input requires a value"; return 2; }
        CMDABC_INPUT_ARG=$2
        shift 2
        ;;
      *)
        cmdabc_error "unknown argument: $1"
        return 2
        ;;
    esac
  done
}

cmdabc_load_library() {
  local library=$1
  # Validation and management stay strict. Picker callers opt into tolerant
  # loading so one locatable entry without a command cannot hide valid rows.
  local mode=${2:-strict}
  local line line_number path command prior path_error conflict
  local pending_index
  local -a pending_paths pending_lines pending_raw pending_errors

  CMDABC_PATHS=()
  CMDABC_COMMANDS=()
  CMDABC_ENTRY_VALID=()
  CMDABC_ENTRY_LINES=()
  CMDABC_ENTRY_RAW=()
  CMDABC_ENTRY_ERRORS=()

  [ -f "$library" ] || { cmdabc_error "library not found: $library"; return 2; }
  [ -r "$library" ] || { cmdabc_error "library is not readable: $library"; return 2; }

  line_number=0
  while IFS= read -r line || [ -n "$line" ]; do
    line_number=$((line_number + 1))

    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    case "$line" in
      \#*) continue ;;
    esac

    case "$line" in
      *[[:space:]]*)
        path=${line%%[[:space:]]*}
        command=${line#"$path"}
        command=${command#?}
        ;;
      *)
        if [ "$mode" = strict ]; then
          cmdabc_error "$library:$line_number: missing command delimiter"
          return 2
        fi
        path=$line
        command=''
        ;;
    esac

    path_error=''
    [ -n "$path" ] || path_error='empty path'
    case "$path" in
      abc|abc.*) path_error='reserved namespace: abc' ;;
      .*|*.|*..*) path_error="path contains an empty segment: $path" ;;
      *[[:space:]]*) path_error="path contains whitespace: $path" ;;
    esac
    if [ -n "$path_error" ]; then
      if [ "$mode" = strict ]; then
        cmdabc_error "$library:$line_number: $path_error"
        return 2
      fi
      continue
    fi

    if ! [[ "$command" =~ [^[:space:]] ]]; then
      if [ "$mode" = strict ]; then
        cmdabc_error "$library:$line_number: empty command"
        return 2
      fi
      pending_paths[${#pending_paths[@]}]=$path
      pending_lines[${#pending_lines[@]}]=$line_number
      pending_raw[${#pending_raw[@]}]=$line
      pending_errors[${#pending_errors[@]}]='missing command'
      continue
    fi

    conflict=0
    for prior in "${CMDABC_PATHS[@]}"; do
      if [ "$prior" = "$path" ]; then
        if [ "$mode" = strict ]; then
          cmdabc_error "$library:$line_number: duplicate path: $path"
          return 2
        fi
        conflict=1
        break
      fi
      case "$prior" in
        "$path".*)
          if [ "$mode" = strict ]; then
            cmdabc_error "$library:$line_number: node is both leaf and parent: $path"
            return 2
          fi
          conflict=1
          break
          ;;
      esac
      case "$path" in
        "$prior".*)
          if [ "$mode" = strict ]; then
            cmdabc_error "$library:$line_number: node is both leaf and parent: $prior"
            return 2
          fi
          conflict=1
          break
          ;;
      esac
    done
    [ "$conflict" -eq 0 ] || continue

    CMDABC_PATHS[${#CMDABC_PATHS[@]}]=$path
    CMDABC_COMMANDS[${#CMDABC_COMMANDS[@]}]=$command
    CMDABC_ENTRY_VALID[${#CMDABC_ENTRY_VALID[@]}]=1
    CMDABC_ENTRY_LINES[${#CMDABC_ENTRY_LINES[@]}]=$line_number
    CMDABC_ENTRY_RAW[${#CMDABC_ENTRY_RAW[@]}]=$line
    CMDABC_ENTRY_ERRORS[${#CMDABC_ENTRY_ERRORS[@]}]=''
  done < "$library"

  if [ "$mode" = tolerant ]; then
    # Add invalid leaves after valid records so an incomplete path can never
    # shadow an otherwise usable command or namespace branch.
    pending_index=0
    while [ "$pending_index" -lt "${#pending_paths[@]}" ]; do
      path=${pending_paths[$pending_index]}
      conflict=0
      for prior in "${CMDABC_PATHS[@]}"; do
        case "$prior" in
          "$path"|"$path".*) conflict=1; break ;;
        esac
        case "$path" in
          "$prior".*) conflict=1; break ;;
        esac
      done
      if [ "$conflict" -eq 0 ]; then
        CMDABC_PATHS[${#CMDABC_PATHS[@]}]=$path
        CMDABC_COMMANDS[${#CMDABC_COMMANDS[@]}]=''
        CMDABC_ENTRY_VALID[${#CMDABC_ENTRY_VALID[@]}]=0
        CMDABC_ENTRY_LINES[${#CMDABC_ENTRY_LINES[@]}]=${pending_lines[$pending_index]}
        CMDABC_ENTRY_RAW[${#CMDABC_ENTRY_RAW[@]}]=${pending_raw[$pending_index]}
        CMDABC_ENTRY_ERRORS[${#CMDABC_ENTRY_ERRORS[@]}]=${pending_errors[$pending_index]}
      fi
      pending_index=$((pending_index + 1))
    done
  fi
}

cmdabc_load_system_library() {
  CMDABC_PATHS=(
    abc.add
    abc.del
    abc.help
    abc.list
    abc.update
  )
  CMDABC_COMMANDS=(
    /abc.add.
    /abc.del.
    /abc.help
    /abc.list
    /abc.update.
  )
  CMDABC_ENTRY_VALID=(1 1 1 1 1)
  CMDABC_ENTRY_LINES=(0 0 0 0 0)
  CMDABC_ENTRY_RAW=('' '' '' '' '')
  CMDABC_ENTRY_ERRORS=('' '' '' '' '')
}

cmdabc_build_children() {
  local parent=$1
  local index path remainder name child_index seen

  CMDABC_CHILD_NAMES=()
  CMDABC_CHILD_TYPES=()
  CMDABC_CHILD_COMMANDS=()
  CMDABC_CHILD_VALID=()
  CMDABC_CHILD_LINES=()
  CMDABC_CHILD_RAW=()
  CMDABC_CHILD_ERRORS=()

  index=0
  while [ "$index" -lt "${#CMDABC_PATHS[@]}" ]; do
    path=${CMDABC_PATHS[$index]}
    case "$path" in
      "$parent".*)
        remainder=${path#"$parent".}
        name=${remainder%%.*}
        seen=0
        child_index=0
        while [ "$child_index" -lt "${#CMDABC_CHILD_NAMES[@]}" ]; do
          if [ "${CMDABC_CHILD_NAMES[$child_index]}" = "$name" ]; then
            seen=1
            break
          fi
          child_index=$((child_index + 1))
        done
        if [ "$seen" -eq 0 ]; then
          CMDABC_CHILD_NAMES[${#CMDABC_CHILD_NAMES[@]}]=$name
          if [ "$remainder" = "$name" ]; then
            CMDABC_CHILD_TYPES[${#CMDABC_CHILD_TYPES[@]}]="leaf"
            CMDABC_CHILD_COMMANDS[${#CMDABC_CHILD_COMMANDS[@]}]=${CMDABC_COMMANDS[$index]}
            CMDABC_CHILD_VALID[${#CMDABC_CHILD_VALID[@]}]=${CMDABC_ENTRY_VALID[$index]}
            CMDABC_CHILD_LINES[${#CMDABC_CHILD_LINES[@]}]=${CMDABC_ENTRY_LINES[$index]}
            CMDABC_CHILD_RAW[${#CMDABC_CHILD_RAW[@]}]=${CMDABC_ENTRY_RAW[$index]}
            CMDABC_CHILD_ERRORS[${#CMDABC_CHILD_ERRORS[@]}]=${CMDABC_ENTRY_ERRORS[$index]}
          else
            CMDABC_CHILD_TYPES[${#CMDABC_CHILD_TYPES[@]}]="parent"
            CMDABC_CHILD_COMMANDS[${#CMDABC_CHILD_COMMANDS[@]}]=""
            CMDABC_CHILD_VALID[${#CMDABC_CHILD_VALID[@]}]=1
            CMDABC_CHILD_LINES[${#CMDABC_CHILD_LINES[@]}]=0
            CMDABC_CHILD_RAW[${#CMDABC_CHILD_RAW[@]}]=''
            CMDABC_CHILD_ERRORS[${#CMDABC_CHILD_ERRORS[@]}]=''
          fi
        fi
        ;;
    esac
    index=$((index + 1))
  done
}

cmdabc_validate() {
  cmdabc_parse_args "$@" || return $?
  [ -n "$CMDABC_LIBRARY_ARG" ] || { cmdabc_error "validate requires --library"; return 2; }
  cmdabc_load_library "$CMDABC_LIBRARY_ARG" || return $?
  printf 'OK: %s command records\n' "${#CMDABC_PATHS[@]}"
}

cmdabc_children() {
  local index
  cmdabc_parse_args "$@" || return $?
  [ -n "$CMDABC_LIBRARY_ARG" ] || { cmdabc_error "children requires --library"; return 2; }
  [ -n "$CMDABC_PATH_ARG" ] || { cmdabc_error "children requires --path"; return 2; }
  case "$CMDABC_PATH_ARG" in
    abc|abc.*) cmdabc_load_system_library ;;
    *) cmdabc_load_library "$CMDABC_LIBRARY_ARG" tolerant || return $? ;;
  esac
  cmdabc_build_children "$CMDABC_PATH_ARG"
  [ "${#CMDABC_CHILD_NAMES[@]}" -gt 0 ] || { cmdabc_error "path not found: $CMDABC_PATH_ARG"; return 3; }

  index=0
  while [ "$index" -lt "${#CMDABC_CHILD_NAMES[@]}" ]; do
    printf '%s\t%s\t%s\n' \
      "${CMDABC_CHILD_NAMES[$index]}" \
      "${CMDABC_CHILD_TYPES[$index]}" \
      "${CMDABC_CHILD_COMMANDS[$index]}"
    index=$((index + 1))
  done
}

CMDABC_WRITE_TEMP=''

cmdabc_write_cleanup() {
  if [ -n "$CMDABC_WRITE_TEMP" ] && [ -e "$CMDABC_WRITE_TEMP" ]; then
    rm -f "$CMDABC_WRITE_TEMP"
  fi
}

cmdabc_read_file_exact() {
  local output_name=$1
  local path=$2
  local value

  value=$(cat "$path"; printf '\001') || return 1
  value=${value%$'\001'}
  printf -v "$output_name" '%s' "$value"
}

cmdabc_validate_user_target() {
  local target=$1

  [ -n "$target" ] || { cmdabc_error "target is empty"; return 2; }
  case "$target" in
    \#*) cmdabc_error "target cannot start with #: $target"; return 2 ;;
    .*|*.|*..*) cmdabc_error "target contains an empty segment: $target"; return 2 ;;
    *[[:space:]]*) cmdabc_error "target contains whitespace: $target"; return 2 ;;
    abc|abc.*) cmdabc_error "target uses reserved namespace: abc"; return 2 ;;
  esac
}

cmdabc_find_path_index() {
  local wanted=$1
  local index=0

  CMDABC_FOUND_INDEX=-1
  while [ "$index" -lt "${#CMDABC_PATHS[@]}" ]; do
    if [ "${CMDABC_PATHS[$index]}" = "$wanted" ]; then
      CMDABC_FOUND_INDEX=$index
      return 0
    fi
    index=$((index + 1))
  done
  return 1
}

cmdabc_check_new_target() {
  local target=$1
  local prior

  for prior in "${CMDABC_PATHS[@]}"; do
    if [ "$prior" = "$target" ]; then
      cmdabc_error "target already exists: $target"
      return 3
    fi
    case "$prior" in
      "$target".*)
        cmdabc_error "target is already a parent: $target"
        return 3
        ;;
    esac
    case "$target" in
      "$prior".*)
        cmdabc_error "target is below an existing command: $prior"
        return 3
        ;;
    esac
  done
}

cmdabc_prepare_write_temp() {
  local library=$1
  local parent=${library%/*}

  [ ! -L "$library" ] || { cmdabc_error "refusing to modify symlink library: $library"; return 2; }
  [ -f "$library" ] || { cmdabc_error "library not found: $library"; return 2; }
  [ -r "$library" ] || { cmdabc_error "library is not readable: $library"; return 2; }
  [ -w "$library" ] || { cmdabc_error "library is not writable: $library"; return 2; }
  [ -d "$parent" ] && [ -w "$parent" ] \
    || { cmdabc_error "library directory is not writable: $parent"; return 2; }

  CMDABC_WRITE_TEMP=$library.cmdabc.$$
  if [ -e "$CMDABC_WRITE_TEMP" ] || [ -L "$CMDABC_WRITE_TEMP" ]; then
    cmdabc_error "temporary path already exists: $CMDABC_WRITE_TEMP"
    CMDABC_WRITE_TEMP=''
    return 2
  fi
  cp -p "$library" "$CMDABC_WRITE_TEMP" \
    || { cmdabc_error "cannot prepare library update"; CMDABC_WRITE_TEMP=''; return 2; }
  trap 'cmdabc_write_cleanup; exit 130' INT TERM HUP
  trap 'cmdabc_write_cleanup' EXIT
}

cmdabc_commit_write_temp() {
  local library=$1

  cmdabc_load_library "$CMDABC_WRITE_TEMP" || return $?
  mv -f "$CMDABC_WRITE_TEMP" "$library" || { cmdabc_error "cannot replace library"; return 2; }
  CMDABC_WRITE_TEMP=''
  trap - EXIT INT TERM HUP
}

cmdabc_manage_add() {
  local library=$1
  local target=$2
  local command=$3
  local content

  cmdabc_validate_user_target "$target" || return $?
  [[ "$command" =~ [^[:space:]] ]] || { cmdabc_error "add command is empty"; return 2; }
  cmdabc_load_library "$library" || return $?
  cmdabc_check_new_target "$target" || return $?
  cmdabc_prepare_write_temp "$library" || return $?
  cmdabc_read_file_exact content "$library" || { cmdabc_error "cannot read library"; return 2; }
  if [ -n "$content" ] && [[ "$content" != *$'\n' ]]; then
    printf '\n' >> "$CMDABC_WRITE_TEMP" || { cmdabc_error "cannot append library record"; return 2; }
  fi
  printf '%s %s\n' "$target" "$command" >> "$CMDABC_WRITE_TEMP" \
    || { cmdabc_error "cannot append library record"; return 2; }
  cmdabc_commit_write_temp "$library" || return $?
  printf 'Added: %s\n' "$target"
}

cmdabc_rewrite_target() {
  local operation=$1
  local library=$2
  local target=$3
  local command=${4:-}
  local line status path output_line

  cmdabc_validate_user_target "$target" || return $?
  cmdabc_load_library "$library" || return $?
  cmdabc_find_path_index "$target" \
    || { cmdabc_error "target not found: $target"; return 3; }
  if [ "$operation" = update ]; then
    [[ "$command" =~ [^[:space:]] ]] || { cmdabc_error "update command is empty"; return 2; }
  fi

  cmdabc_prepare_write_temp "$library" || return $?
  : > "$CMDABC_WRITE_TEMP" || { cmdabc_error "cannot write temporary library"; return 2; }
  while :; do
    line=''
    IFS= read -r line
    status=$?
    if [ "$status" -ne 0 ] && [ -z "$line" ]; then
      break
    fi
    output_line=$line
    if [[ ! "$line" =~ ^[[:space:]]*$ ]] && [[ "$line" != \#* ]]; then
      path=${line%%[[:space:]]*}
      if [ "$path" = "$target" ]; then
        if [ "$operation" = delete ]; then
          if [ "$status" -ne 0 ]; then
            break
          fi
          continue
        fi
        output_line="$target $command"
      fi
    fi
    if [ "$status" -eq 0 ]; then
      printf '%s\n' "$output_line" >> "$CMDABC_WRITE_TEMP" \
        || { cmdabc_error "cannot write temporary library"; return 2; }
    else
      printf '%s' "$output_line" >> "$CMDABC_WRITE_TEMP" \
        || { cmdabc_error "cannot write temporary library"; return 2; }
      break
    fi
  done < "$library"
  cmdabc_commit_write_temp "$library" || return $?
  case "$operation" in
    update) printf 'Updated: %s\n' "$target" ;;
    delete) printf 'Deleted: %s\n' "$target" ;;
  esac
}

cmdabc_manage_list() {
  local library=$1
  local index line line_number match_index path command path_error
  local valid_count=0 record_count=0 invalid_count=0

  cmdabc_load_library "$library" tolerant || return $?

  index=0
  while [ "$index" -lt "${#CMDABC_PATHS[@]}" ]; do
    if [ "${CMDABC_ENTRY_VALID[$index]}" -eq 1 ]; then
      valid_count=$((valid_count + 1))
    fi
    index=$((index + 1))
  done

  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    case "$line" in
      \#*) continue ;;
    esac
    record_count=$((record_count + 1))
  done < "$library"
  invalid_count=$((record_count - valid_count))

  if [ "$invalid_count" -eq 0 ]; then
    printf '%s user commands\n' "$valid_count"
  elif [ "$invalid_count" -eq 1 ]; then
    printf '%s user commands, 1 invalid entry\n' "$valid_count"
  else
    printf '%s user commands, %s invalid entries\n' "$valid_count" "$invalid_count"
  fi

  line_number=0
  while IFS= read -r line || [ -n "$line" ]; do
    line_number=$((line_number + 1))
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    case "$line" in
      \#*) continue ;;
    esac

    match_index=-1
    index=0
    while [ "$index" -lt "${#CMDABC_ENTRY_LINES[@]}" ]; do
      if [ "${CMDABC_ENTRY_LINES[$index]}" -eq "$line_number" ]; then
        match_index=$index
        break
      fi
      index=$((index + 1))
    done

    if [ "$match_index" -lt 0 ]; then
      case "$line" in
        *[[:space:]]*)
          path=${line%%[[:space:]]*}
          command=${line#"$path"}
          command=${command#?}
          ;;
        *)
          path=$line
          command=''
          ;;
      esac
      path_error=''
      [ -n "$path" ] || path_error='malformed entry'
      case "$path" in
        abc|abc.*|.*|*.|*..*|*[[:space:]]*) path_error='malformed entry' ;;
      esac
      if [ -z "$path_error" ] && ! [[ "$command" =~ [^[:space:]] ]]; then
        printf '%s    ???  [invalid: missing command]\n' "$path"
      else
        printf 'line %s    [invalid: malformed entry]\n' "$line_number"
      fi
    elif [ "${CMDABC_ENTRY_VALID[$match_index]}" -eq 1 ]; then
      printf '%s %s\n' \
        "${CMDABC_PATHS[$match_index]}" \
        "${CMDABC_COMMANDS[$match_index]}"
    else
      printf '%s    ???  [invalid: %s]\n' \
        "${CMDABC_PATHS[$match_index]}" \
        "${CMDABC_ENTRY_ERRORS[$match_index]}"
    fi
  done < "$library"
}

cmdabc_manage_help() {
  cat <<'EOF'
/abc.list
/abc.add.<target> <command>
/abc.update.<target> <command>
/abc.del.<target>
/abc.help

Example: /abc.add.git.status git status
EOF
}

cmdabc_manage() {
  local input remainder target command

  cmdabc_parse_args "$@" || return $?
  [ -n "$CMDABC_LIBRARY_ARG" ] || { cmdabc_error "manage requires --library"; return 2; }
  [ -n "$CMDABC_INPUT_ARG" ] || { cmdabc_error "manage requires --input"; return 2; }
  input=$CMDABC_INPUT_ARG

  case "$input" in
    /abc.list)
      cmdabc_manage_list "$CMDABC_LIBRARY_ARG"
      ;;
    /abc.help)
      cmdabc_manage_help
      ;;
    /abc.add.*)
      remainder=${input#/abc.add.}
      case "$remainder" in
        *[[:space:]]*) ;;
        *) cmdabc_error "usage: /abc.add.<target> <command>"; return 2 ;;
      esac
      target=${remainder%%[[:space:]]*}
      command=${remainder#"$target"}
      command=${command#?}
      cmdabc_manage_add "$CMDABC_LIBRARY_ARG" "$target" "$command"
      ;;
    /abc.update.*)
      remainder=${input#/abc.update.}
      case "$remainder" in
        *[[:space:]]*) ;;
        *) cmdabc_error "usage: /abc.update.<target> <command>"; return 2 ;;
      esac
      target=${remainder%%[[:space:]]*}
      command=${remainder#"$target"}
      command=${command#?}
      cmdabc_rewrite_target update "$CMDABC_LIBRARY_ARG" "$target" "$command"
      ;;
    /abc.del.*)
      target=${input#/abc.del.}
      case "$target" in
        ''|*[[:space:]]*) cmdabc_error "usage: /abc.del.<target>"; return 2 ;;
      esac
      cmdabc_rewrite_target delete "$CMDABC_LIBRARY_ARG" "$target"
      ;;
    *)
      cmdabc_error "unknown management command: $input"
      return 2
      ;;
  esac
}

CMDABC_TTY_ACTIVE=0

cmdabc_tty_cleanup() {
  if [ "$CMDABC_TTY_ACTIVE" -eq 1 ]; then
    printf '\033[?25h\033[?1049l' >&4
    CMDABC_TTY_ACTIVE=0
  fi
}

cmdabc_append_visible_children() {
  local parent=$1
  local depth=$2
  local expanded_path=$3
  local index child_path is_expanded
  local -a child_names child_types child_commands child_valid child_lines
  local -a child_raw child_errors

  cmdabc_build_children "$parent"
  child_names=("${CMDABC_CHILD_NAMES[@]}")
  child_types=("${CMDABC_CHILD_TYPES[@]}")
  child_commands=("${CMDABC_CHILD_COMMANDS[@]}")
  child_valid=("${CMDABC_CHILD_VALID[@]}")
  child_lines=("${CMDABC_CHILD_LINES[@]}")
  child_raw=("${CMDABC_CHILD_RAW[@]}")
  child_errors=("${CMDABC_CHILD_ERRORS[@]}")

  index=0
  while [ "$index" -lt "${#child_names[@]}" ]; do
    child_path="$parent.${child_names[$index]}"
    is_expanded=0
    if [ "${child_types[$index]}" = "parent" ]; then
      case "$expanded_path" in
        "$child_path"|"$child_path".*) is_expanded=1 ;;
      esac
    fi

    CMDABC_VISIBLE_NAMES[${#CMDABC_VISIBLE_NAMES[@]}]=${child_names[$index]}
    CMDABC_VISIBLE_TYPES[${#CMDABC_VISIBLE_TYPES[@]}]=${child_types[$index]}
    CMDABC_VISIBLE_COMMANDS[${#CMDABC_VISIBLE_COMMANDS[@]}]=${child_commands[$index]}
    CMDABC_VISIBLE_VALID[${#CMDABC_VISIBLE_VALID[@]}]=${child_valid[$index]}
    CMDABC_VISIBLE_LINES[${#CMDABC_VISIBLE_LINES[@]}]=${child_lines[$index]}
    CMDABC_VISIBLE_RAW[${#CMDABC_VISIBLE_RAW[@]}]=${child_raw[$index]}
    CMDABC_VISIBLE_ERRORS[${#CMDABC_VISIBLE_ERRORS[@]}]=${child_errors[$index]}
    CMDABC_VISIBLE_PATHS[${#CMDABC_VISIBLE_PATHS[@]}]=$child_path
    CMDABC_VISIBLE_DEPTHS[${#CMDABC_VISIBLE_DEPTHS[@]}]=$depth
    CMDABC_VISIBLE_EXPANDED[${#CMDABC_VISIBLE_EXPANDED[@]}]=$is_expanded

    if [ "$is_expanded" -eq 1 ]; then
      cmdabc_append_visible_children "$child_path" "$((depth + 1))" "$expanded_path"
    fi
    index=$((index + 1))
  done
}

cmdabc_build_visible() {
  local namespace=$1
  local expanded_path=$2

  CMDABC_VISIBLE_NAMES=()
  CMDABC_VISIBLE_TYPES=()
  CMDABC_VISIBLE_COMMANDS=()
  CMDABC_VISIBLE_VALID=()
  CMDABC_VISIBLE_LINES=()
  CMDABC_VISIBLE_RAW=()
  CMDABC_VISIBLE_ERRORS=()
  CMDABC_VISIBLE_PATHS=()
  CMDABC_VISIBLE_DEPTHS=()
  CMDABC_VISIBLE_EXPANDED=()
  cmdabc_append_visible_children "$namespace" 0 "$expanded_path"
}

cmdabc_find_visible_index() {
  local wanted_path=$1
  local index=0

  CMDABC_VISIBLE_INDEX=-1
  while [ "$index" -lt "${#CMDABC_VISIBLE_PATHS[@]}" ]; do
    if [ "${CMDABC_VISIBLE_PATHS[$index]}" = "$wanted_path" ]; then
      CMDABC_VISIBLE_INDEX=$index
      return 0
    fi
    index=$((index + 1))
  done
  return 1
}

cmdabc_render() {
  local namespace=$1
  local selected=$2
  local index marker suffix indent depth name command preview preview_sgr gap
  local columns content_width row_width available preview_chars

  columns=${COLUMNS:-80}
  case "$columns" in
    ''|*[!0-9]*|0) columns=80 ;;
  esac
  content_width=$((10#$columns - 1))
  [ "$content_width" -ge 1 ] || content_width=1
  gap='  '

  printf '\033[H\033[2J' >&4
  printf 'CmdABC  /%s.\n\n' "$namespace" >&4
  index=0
  while [ "$index" -lt "${#CMDABC_VISIBLE_NAMES[@]}" ]; do
    indent=''
    depth=${CMDABC_VISIBLE_DEPTHS[$index]}
    while [ "$depth" -gt 0 ]; do
      indent="$indent  "
      depth=$((depth - 1))
    done
    marker='  '
    [ "$index" -eq "$selected" ] && marker='> '
    suffix=''
    if [ "${CMDABC_VISIBLE_TYPES[$index]}" = "parent" ]; then
      if [ "${CMDABC_VISIBLE_EXPANDED[$index]}" -eq 1 ]; then
        suffix=' ▾'
      else
        suffix=' ▸'
      fi
    fi
    name=${CMDABC_VISIBLE_NAMES[$index]}
    printf '%s%s%s%s' "$indent" "$marker" "$name" "$suffix" >&4
    if [ "${CMDABC_VISIBLE_TYPES[$index]}" = "leaf" ]; then
      if [ "${CMDABC_VISIBLE_VALID[$index]}" -eq 1 ]; then
        command=${CMDABC_VISIBLE_COMMANDS[$index]}
        preview=$command
        preview_sgr='2;3'
      else
        preview='???'
        preview_sgr='2'
      fi
      row_width=$((${#indent} + ${#marker} + ${#name} + ${#suffix}))
      available=$((content_width - row_width - ${#gap}))
      if [ "$available" -ge 8 ]; then
        if [ "${#preview}" -gt "$available" ]; then
          preview_chars=$((available - 1))
          preview=${preview:0:preview_chars}'…'
        fi
        printf '%s\033[%sm%s\033[0m' "$gap" "$preview_sgr" "$preview" >&4
      fi
    fi
    printf '\n' >&4
    index=$((index + 1))
  done
  printf '\n↑/↓ select   Enter/Right open   Left back   Esc cancel' >&4
}

cmdabc_read_escape_byte() {
  local __cmdabc_byte

  # Bash 3.2 does not accept fractional `read -t` values. It is only used as
  # the picker launcher on macOS, so it gets a conservative one-second timeout.
  # Target Bash 5.2 uses the short timeout.
  __cmdabc_byte=''
  if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
    IFS= read -r -s -n 1 -t 0.08 __cmdabc_byte <&3
  else
    IFS= read -r -s -n 1 -t 1 __cmdabc_byte <&3
  fi
  CMDABC_ESCAPE_BYTE=$__cmdabc_byte
  [ -n "$CMDABC_ESCAPE_BYTE" ]
}

cmdabc_finish_leaf_selection() {
  local selected=$1

  cmdabc_tty_cleanup
  trap - EXIT INT TERM HUP
  if [ "${CMDABC_VISIBLE_VALID[$selected]}" -ne 1 ]; then
    # Status 5 tells the shell widget to clear its editor buffer and present
    # this captured message on a fresh line.
    printf 'CmdABC: invalid command entry\n'
    printf '  line %s: %s\n' \
      "${CMDABC_VISIBLE_LINES[$selected]}" \
      "${CMDABC_VISIBLE_RAW[$selected]}"
    printf '  expected: <namespace.path> <command>\n'
    return 5
  fi
  printf '%s\n' "${CMDABC_VISIBLE_COMMANDS[$selected]}"
  return 0
}

cmdabc_pick() {
  local namespace expanded_path selected_path selected key second third
  local type path parent_path ancestor_path status

  cmdabc_parse_args "$@" || return $?
  [ -n "$CMDABC_LIBRARY_ARG" ] || { cmdabc_error "pick requires --library"; return 2; }
  [ -n "$CMDABC_NAMESPACE_ARG" ] || { cmdabc_error "pick requires --namespace"; return 2; }
  namespace=$CMDABC_NAMESPACE_ARG
  case "$namespace" in
    *[!A-Za-z0-9_-]*) cmdabc_error "invalid namespace: $namespace"; return 2 ;;
  esac

  if [ "$namespace" = abc ]; then
    cmdabc_load_system_library
  else
    cmdabc_load_library "$CMDABC_LIBRARY_ARG" tolerant || return $?
  fi
  cmdabc_build_children "$namespace"
  [ "${#CMDABC_CHILD_NAMES[@]}" -gt 0 ] || { cmdabc_error "namespace not found: $namespace"; return 3; }

  exec 3</dev/tty 4>/dev/tty || { cmdabc_error "pick requires a controlling terminal"; return 4; }
  trap 'cmdabc_tty_cleanup; exit 130' INT TERM HUP
  trap 'cmdabc_tty_cleanup' EXIT
  CMDABC_TTY_ACTIVE=1
  printf '\033[?1049h\033[?25l' >&4

  expanded_path=''
  selected_path=''
  while :; do
    cmdabc_build_visible "$namespace" "$expanded_path"
    if [ "${#CMDABC_VISIBLE_NAMES[@]}" -eq 0 ]; then
      cmdabc_tty_cleanup
      trap - EXIT INT TERM HUP
      cmdabc_error "namespace has no children: $namespace"
      return 3
    fi
    if [ -n "$selected_path" ] && cmdabc_find_visible_index "$selected_path"; then
      selected=$CMDABC_VISIBLE_INDEX
    else
      selected=0
      selected_path=${CMDABC_VISIBLE_PATHS[0]}
    fi
    cmdabc_render "$namespace" "$selected"

    key=''
    IFS= read -r -s -n 1 key <&3
    status=$?
    [ "$status" -eq 0 ] || continue

    case "$key" in
      ''|$'\r'|$'\n')
        type=${CMDABC_VISIBLE_TYPES[$selected]}
        path=${CMDABC_VISIBLE_PATHS[$selected]}
        if [ "$type" = "parent" ]; then
          cmdabc_build_children "$path"
          expanded_path=$path
          selected_path="$path.${CMDABC_CHILD_NAMES[0]}"
        else
          cmdabc_finish_leaf_selection "$selected"
          return $?
        fi
        ;;
      $'\033')
        second=''
        if ! cmdabc_read_escape_byte; then
          cmdabc_tty_cleanup
          trap - EXIT INT TERM HUP
          return 130
        fi
        second=$CMDABC_ESCAPE_BYTE
        if [ "$second" != '[' ]; then
          continue
        fi
        third=''
        cmdabc_read_escape_byte || continue
        third=$CMDABC_ESCAPE_BYTE
        case "$third" in
          A)
            selected=$((selected - 1))
            [ "$selected" -ge 0 ] || selected=$((${#CMDABC_VISIBLE_NAMES[@]} - 1))
            selected_path=${CMDABC_VISIBLE_PATHS[$selected]}
            ;;
          B)
            selected=$((selected + 1))
            [ "$selected" -lt "${#CMDABC_VISIBLE_NAMES[@]}" ] || selected=0
            selected_path=${CMDABC_VISIBLE_PATHS[$selected]}
            ;;
          C)
            type=${CMDABC_VISIBLE_TYPES[$selected]}
            path=${CMDABC_VISIBLE_PATHS[$selected]}
            if [ "$type" = "parent" ]; then
              cmdabc_build_children "$path"
              expanded_path=$path
              selected_path="$path.${CMDABC_CHILD_NAMES[0]}"
            else
              cmdabc_finish_leaf_selection "$selected"
              return $?
            fi
            ;;
          D)
            if [ "${CMDABC_VISIBLE_DEPTHS[$selected]}" -gt 0 ]; then
              path=${CMDABC_VISIBLE_PATHS[$selected]}
              parent_path=${path%.*}
              ancestor_path=${parent_path%.*}
              if [ "$ancestor_path" = "$namespace" ]; then
                expanded_path=''
              else
                expanded_path=$ancestor_path
              fi
              selected_path=$parent_path
            fi
            ;;
        esac
        ;;
    esac
  done
}

case "${1:-}" in
  validate)
    shift
    cmdabc_validate "$@"
    ;;
  children)
    shift
    cmdabc_children "$@"
    ;;
  pick)
    shift
    cmdabc_pick "$@"
    ;;
  manage)
    shift
    cmdabc_manage "$@"
    ;;
  --version)
    [ -n "$CMDABC_VERSION" ] || { cmdabc_error "VERSION not found"; exit 2; }
    printf '%s\n' "$CMDABC_VERSION"
    ;;
  -h|--help|'')
    cmdabc_usage
    ;;
  *)
    cmdabc_error "unknown command: $1"
    cmdabc_usage >&2
    exit 2
    ;;
esac
