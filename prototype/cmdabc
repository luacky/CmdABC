  local cursor=$2
  local error_kind=$3
  local error=$4
  local locked=$5
  local preview=$6
  local column

  printf '\033[H\033[JDelete a command\n' >&4
  if [ "$locked" -eq 1 ]; then
    printf 'Check the command, then press Enter\n' >&4
  else
    printf 'Type a name like a.b, then press Space\n' >&4
  fi
  if [ -n "$error" ]; then
    cmdabc_user_reason "$error"
    error=$CMDABC_USER_REASON
    case "$error_kind" in
