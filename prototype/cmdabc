CMDABC_TTY_ACTIVE=0

cmdabc_tty_cleanup() {
  if [ "$CMDABC_TTY_ACTIVE" -eq 1 ]; then
    printf '\033[?25h\033[?1049l' >&4
    CMDABC_TTY_ACTIVE=0
  fi
}

cmdabc_tty_open() {
  exec 3</dev/tty 4>/dev/tty \
    || { cmdabc_error "interactive mode requires a controlling terminal"; return 4; }
  trap 'cmdabc_tty_cleanup; exit 130' INT TERM HUP
  trap 'cmdabc_tty_cleanup' EXIT
  CMDABC_TTY_ACTIVE=1
  printf '\033[?1049h\033[?25l' >&4
}

cmdabc_render_add() {
  local stage=$1
  local name=$2
  local command=$3
  local cursor=$4
  local error_kind=$5
  local error=$6
  local column

  # Stay inside the picker's existing alternate-screen session. Repaint the
  # current UI state without opening or closing another full-screen context.
  printf '\033[H\033[JAdd a command\n' >&4
  if [ "$stage" = command ]; then
    printf 'Type the command, then press Enter\n' >&4
  else
    printf 'Type a name like a.b, then press Space\n' >&4
  fi
  if [ -n "$error" ]; then
    cmdabc_user_reason "$error"
    error=$CMDABC_USER_REASON
    case "$error_kind" in
      error) printf '\033[31m[error: %s]\033[0m\n' "$error" >&4 ;;
      *) printf '\033[31m[invalid: %s]\033[0m\n' "$error" >&4 ;;
    esac
  else
    printf '\n' >&4
  fi
  if [ "$stage" = command ]; then
    printf '/%s %s\n\nEnter add   Esc back' "$name" "$command" >&4
    column=$((${#name} + cursor + 3))
  else
    printf '/%s\n\nSpace next   Esc back' "$name" >&4
    column=$((cursor + 2))
  fi
  printf '\033[4;%sH\033[?25h' "$column" >&4
}

cmdabc_read_bracketed_paste() {
  local key status sequence part count

  CMDABC_PASTE_TEXT=''
  CMDABC_PASTE_MULTILINE=0
  CMDABC_PASTE_CONTROL=0
  while :; do
    key=''
    if cmdabc_read_tty_byte; then
      key=$CMDABC_TTY_BYTE
    else
      CMDABC_PASTE_CONTROL=1
      return 1
    fi
    if [ -z "$key" ] || [ "$key" = $'\n' ] || [ "$key" = $'\r' ]; then
      CMDABC_PASTE_MULTILINE=1
      continue
    fi
    if [ "$key" = $'\033' ]; then
      sequence=''
      count=0
      while [ "$count" -lt 5 ]; do
        part=''
        if cmdabc_read_tty_byte; then
          part=$CMDABC_TTY_BYTE
        else
          CMDABC_PASTE_CONTROL=1
          return 1
        fi
        if [ -z "$part" ]; then
          CMDABC_PASTE_MULTILINE=1
        else
          sequence=$sequence$part
        fi
        count=$((count + 1))
      done
      if [ "$sequence" = '[201~' ]; then
        return 0
      fi
      CMDABC_PASTE_CONTROL=1
      continue
    fi
    CMDABC_PASTE_TEXT=$CMDABC_PASTE_TEXT$key
  done
}

cmdabc_check_add_name() {
  local library=$1
  local target=$2

  CMDABC_INVALID_REASON=''
  cmdabc_validate_user_target "$target" || {
    if [ -n "$target" ] && [ "$CMDABC_TARGET_ERROR" = 'invalid target' ]; then
      CMDABC_INVALID_REASON='name needs a dot'
    else
      CMDABC_INVALID_REASON=$CMDABC_TARGET_ERROR
    fi
    return 2
  }
  cmdabc_load_library "$library" tolerant || return $?
  cmdabc_check_new_target "$target"
}

# Runs inside the current alternate-screen TTY session. Return 0 after a
# successful append, or 10 when Esc asks the caller to return/cancel.
cmdabc_add_editor() {
  local library=$1
  local stage=name name='' command='' cursor=0 error_kind='' error='' key='' status
  local before after paste_name paste_command

  while :; do
    cmdabc_render_add "$stage" "$name" "$command" "$cursor" "$error_kind" "$error"
    key=''
    if cmdabc_read_tty_byte; then
      key=$CMDABC_TTY_BYTE
    else
      CMDABC_ADD_FAILURE_MESSAGE='[error: terminal input failed]'
      return 11
    fi

    case "$key" in
      ''|$'\r'|$'\n')
        if [ "$stage" = name ]; then
          error_kind=invalid
          error='press Space to continue'
          cursor=${#name}
          continue
        fi
        CMDABC_ERROR_REASON=''
        CMDABC_DEFER_ERRORS=1
        if cmdabc_add_record "$library" "$name" "$command"; then
          CMDABC_DEFER_ERRORS=0
          CMDABC_ADD_RESULT_TARGET=$name
          return 0
        else
          status=$?
        fi
        CMDABC_DEFER_ERRORS=0
        if [ -n "$CMDABC_INVALID_REASON" ]; then
          error_kind=invalid
          error=$CMDABC_INVALID_REASON
        else
          error_kind=error
          error=${CMDABC_ERROR_REASON:-failed to update command library}
        fi
        cursor=${#command}
        ;;
      ' ')
        if [ "$stage" = command ]; then
          before=${command:0:$cursor}
          after=${command:$cursor}
          command=$before$key$after
          cursor=$((cursor + 1))
          error_kind=''
          error=''
          continue
        fi
        CMDABC_ERROR_REASON=''
        CMDABC_DEFER_ERRORS=1
        if cmdabc_check_add_name "$library" "$name"; then
          status=0
        else
          status=$?
        fi
        CMDABC_DEFER_ERRORS=0
        if [ "$status" -eq 0 ]; then
          stage=command
          cursor=0
          error_kind=''
          error=''
        elif [ -n "$CMDABC_INVALID_REASON" ]; then
          error_kind=invalid
          error=$CMDABC_INVALID_REASON
          cursor=${#name}
        else
          error_kind=error
          error=${CMDABC_ERROR_REASON:-command library is not readable}
          cursor=${#name}
        fi
        ;;
      $'\177'|$'\010')
        if [ "$stage" = command ]; then
          if [ -z "$command" ]; then
            stage=name
            cursor=${#name}
          elif [ "$cursor" -gt 0 ]; then
            before=${command:0:$((cursor - 1))}
            after=${command:$cursor}
            command=$before$after
            cursor=$((cursor - 1))
          fi
        elif [ "$cursor" -gt 0 ]; then
          before=${name:0:$((cursor - 1))}
          after=${name:$cursor}
          name=$before$after
          cursor=$((cursor - 1))
        fi
        error_kind=''
        error=''
        ;;
      $'\025')
        if [ "$stage" = command ]; then
          command=''
        else
          name=''
        fi
        cursor=0
        error_kind=''
        error=''
        ;;
      $'\033')
        if ! cmdabc_read_escape_sequence; then
          return 10
        fi
        case "$CMDABC_ESCAPE_SEQUENCE" in
          '[C')
            if [ "$stage" = command ]; then
              [ "$cursor" -ge "${#command}" ] || cursor=$((cursor + 1))
            else
              [ "$cursor" -ge "${#name}" ] || cursor=$((cursor + 1))
            fi
            ;;
          '[D')
            [ "$cursor" -le 0 ] || cursor=$((cursor - 1))
            ;;
          '[H') cursor=0 ;;
          '[F')
            if [ "$stage" = command ]; then
              cursor=${#command}
            else
              cursor=${#name}
            fi
            ;;
          '[200~')
            cmdabc_read_bracketed_paste
            if [ "$CMDABC_PASTE_MULTILINE" -eq 1 ]; then
              error_kind=invalid
              error='multiline input'
            elif [ "$CMDABC_PASTE_CONTROL" -eq 1 ]; then
              error_kind=invalid
              error='malformed entry'
            elif [ "$stage" = command ]; then
              before=${command:0:$cursor}
              after=${command:$cursor}
              command=$before$CMDABC_PASTE_TEXT$after
              cursor=$((cursor + ${#CMDABC_PASTE_TEXT}))
              error_kind=''
              error=''
            else
              paste_name=$CMDABC_PASTE_TEXT
              paste_command=''
              case "$CMDABC_PASTE_TEXT" in
                *[[:space:]]*)
                  paste_name=${CMDABC_PASTE_TEXT%%[[:space:]]*}
                  paste_command=${CMDABC_PASTE_TEXT#"$paste_name"}
                  paste_command=${paste_command#?}
                  ;;
              esac
              before=${name:0:$cursor}
              after=${name:$cursor}
              name=$before$paste_name$after
              cursor=$((cursor + ${#paste_name}))
              if [ "$paste_name" != "$CMDABC_PASTE_TEXT" ]; then
                CMDABC_ERROR_REASON=''
                CMDABC_DEFER_ERRORS=1
                if cmdabc_check_add_name "$library" "$name"; then
                  status=0
                else
                  status=$?
                fi
                CMDABC_DEFER_ERRORS=0
                if [ "$status" -eq 0 ]; then
                  stage=command
                  command=$paste_command
                  cursor=${#command}
                  error_kind=''
                  error=''
                elif [ -n "$CMDABC_INVALID_REASON" ]; then
                  error_kind=invalid
                  error=$CMDABC_INVALID_REASON
                  cursor=${#name}
                else
                  error_kind=error
                  error=${CMDABC_ERROR_REASON:-command library is not readable}
                  cursor=${#name}
                fi
              else
                error_kind=''
                error=''
              fi
            fi
            ;;
        esac
        ;;
      *)
        if [ "$stage" = command ]; then
          before=${command:0:$cursor}
          after=${command:$cursor}
          command=$before$key$after
        else
          before=${name:0:$cursor}
          after=${name:$cursor}
          name=$before$key$after
        fi
        cursor=$((cursor + ${#key}))
        error_kind=''
        error=''
        ;;
    esac
  done
}

cmdabc_add_interactive() {
  local status

  cmdabc_parse_args "$@" || return $?
  [ -n "$CMDABC_LIBRARY_ARG" ] || { cmdabc_error "add requires --library"; return 2; }
  cmdabc_tty_open || return $?
  if cmdabc_add_editor "$CMDABC_LIBRARY_ARG"; then
    status=0
  else
    status=$?
  fi
  cmdabc_tty_cleanup
  trap - EXIT INT TERM HUP
  if [ "$status" -eq 0 ]; then
    cmdabc_print_added "$CMDABC_ADD_RESULT_TARGET"
    return 0
  fi
  [ "$status" -eq 10 ] && return 0
  if [ "$status" -eq 11 ]; then
    printf '%s\n' "$CMDABC_ADD_FAILURE_MESSAGE" >&2
    return 2
  fi
  return "$status"
}

