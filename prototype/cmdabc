}

cmdabc_lookup_delete_target() {
  local library=$1
  local target=$2
  local index match_count=0 match_index=-1

  CMDABC_INVALID_REASON=''
  CMDABC_DEL_COMMAND=''
  CMDABC_DEL_RAW=''
  CMDABC_DEL_LIBRARY_SNAPSHOT=''
  cmdabc_validate_user_target "$target" \
    || { CMDABC_INVALID_REASON=$CMDABC_TARGET_ERROR; return 2; }
  cmdabc_load_library "$library" tolerant || return $?
  index=0
  while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
    if [ "${CMDABC_RECORD_LOCATABLE[$index]}" -eq 1 ] \
      && [ "${CMDABC_RECORD_PATHS[$index]}" = "$target" ]; then
      match_count=$((match_count + 1))
      match_index=$index
    fi
    index=$((index + 1))
  done
  if [ "$match_count" -gt 1 ]; then
    CMDABC_INVALID_REASON='duplicate target'
    return 3
  fi
  if [ "$match_count" -eq 0 ]; then
    CMDABC_INVALID_REASON='target not found'
    return 3
  fi
  if [ "${CMDABC_RECORD_VALID[$match_index]}" -ne 1 ]; then
    CMDABC_INVALID_REASON=${CMDABC_RECORD_ERRORS[$match_index]}
    return 2
  fi
  CMDABC_DEL_COMMAND=${CMDABC_RECORD_COMMANDS[$match_index]}
  CMDABC_DEL_RAW=${CMDABC_RECORD_RAW[$match_index]}
  cmdabc_read_file_exact CMDABC_DEL_LIBRARY_SNAPSHOT "$library" \
    || { cmdabc_error 'command library is not readable'; return 2; }
}

cmdabc_del_editor() {
  local library=$1
  local buffer='' cursor=0 error_kind='' error='' key='' status
  local locked=0 locked_target='' locked_command='' locked_raw=''
  local locked_snapshot='' current_snapshot=''
  local before after second third fourth fifth sixth paste_target paste_confirms

  while :; do
    cmdabc_render_del "$buffer" "$cursor" "$error_kind" "$error" \
      "$locked" "$locked_command"
    key=''
    if cmdabc_read_tty_byte; then
      key=$CMDABC_TTY_BYTE
      status=0
    else
      status=$?
    fi
    if [ "$status" -ne 0 ]; then
      CMDABC_DEL_FAILURE_MESSAGE='[error: terminal input failed]'
      return 11
    fi

    if [ "$locked" -eq 1 ]; then
      case "$key" in
        ''|$'\r'|$'\n')
          CMDABC_ERROR_REASON=''
          CMDABC_DEFER_ERRORS=1
          current_snapshot=''
          if ! cmdabc_read_file_exact current_snapshot "$library"; then
            CMDABC_ERROR_REASON='failed to remove target'
            status=2
          elif [ "$current_snapshot" != "$locked_snapshot" ]; then
            CMDABC_ERROR_REASON='command library changed, retry'
            status=4
          elif cmdabc_rewrite_target delete "$library" "$locked_target" '' "$locked_raw" 1 1; then
            status=0
          else
            status=$?
          fi
          CMDABC_DEFER_ERRORS=0
          if [ "$status" -eq 0 ]; then
            CMDABC_DEL_RESULT_TARGET=$locked_target
            return 0
          fi
          if [ "$CMDABC_ERROR_REASON" = 'command library changed, retry' ]; then
            error_kind=error
            error=$CMDABC_ERROR_REASON
            locked=0
            locked_target=''
            locked_command=''
            locked_raw=''
            locked_snapshot=''
            cursor=${#buffer}
            continue
          fi
          CMDABC_DEL_FAILURE_MESSAGE="[error: failed to remove /$locked_target]"
          return 11
          ;;
        $'\177'|$'\010')
          locked=0
          locked_target=''
          locked_command=''
          locked_raw=''
          locked_snapshot=''
          error_kind=''
          error=''
          cursor=${#buffer}
          ;;
        $'\033')
          if ! cmdabc_read_escape_sequence; then
            return 10
          fi
          if [ "$CMDABC_ESCAPE_SEQUENCE" = '[200~' ]; then
            cmdabc_read_bracketed_paste
          fi
          ;;
        *) ;;
      esac
      continue
    fi

    case "$key" in
      ''|$'\r'|$'\n')
        error_kind=invalid
        error='press Space to confirm target'
        cursor=${#buffer}
        ;;
      ' ')
        CMDABC_ERROR_REASON=''
        CMDABC_DEFER_ERRORS=1
        if cmdabc_lookup_delete_target "$library" "$buffer"; then
          status=0
        else
          status=$?
        fi
        CMDABC_DEFER_ERRORS=0
        if [ "$status" -eq 0 ]; then
          locked=1
          locked_target=$buffer
          locked_command=$CMDABC_DEL_COMMAND
          locked_raw=$CMDABC_DEL_RAW
          locked_snapshot=$CMDABC_DEL_LIBRARY_SNAPSHOT
          error_kind=''
          error=''
        elif [ -n "$CMDABC_INVALID_REASON" ]; then
          error_kind=invalid
          error=$CMDABC_INVALID_REASON
        else
          error_kind=error
          error=${CMDABC_ERROR_REASON:-command library is not readable}
        fi
        cursor=${#buffer}
        ;;
      $'\177'|$'\010')
        if [ "$cursor" -gt 0 ]; then
          before=${buffer:0:$((cursor - 1))}
          after=${buffer:$cursor}
          buffer=$before$after
          cursor=$((cursor - 1))
        fi
        error_kind=''
        error=''
        ;;
      $'\025')
        buffer=''
        cursor=0
        error_kind=''
        error=''
        ;;
      $'\033')
        if ! cmdabc_read_escape_sequence; then
          return 10
        fi
        case "$CMDABC_ESCAPE_SEQUENCE" in
          '[C')
            [ "$cursor" -ge "${#buffer}" ] || cursor=$((cursor + 1))
            ;;
          '[D')
            [ "$cursor" -le 0 ] || cursor=$((cursor - 1))
            ;;
          '[H') cursor=0 ;;
          '[F') cursor=${#buffer} ;;
          '[200~')
            cmdabc_read_bracketed_paste
            if [ "$CMDABC_PASTE_MULTILINE" -eq 1 ]; then
                error_kind=invalid
                error='multiline input'
            elif [ "$CMDABC_PASTE_CONTROL" -eq 1 ]; then
                error_kind=invalid
                error='malformed entry'
            else
                paste_target=''
                paste_confirms=0
                case "$CMDABC_PASTE_TEXT" in
                  *[[:space:]]*)
                    paste_target=${CMDABC_PASTE_TEXT%%[[:space:]]*}
                    paste_confirms=1
                    ;;
                esac
                if [ "$paste_confirms" -eq 1 ]; then
                  before=${buffer:0:$cursor}
                  after=${buffer:$cursor}
                  buffer=$before$paste_target$after
                  cursor=$((cursor + ${#paste_target}))
                  CMDABC_ERROR_REASON=''
                  CMDABC_DEFER_ERRORS=1
                  if cmdabc_lookup_delete_target "$library" "$buffer"; then
                    status=0
                  else
                    status=$?
                  fi
                  CMDABC_DEFER_ERRORS=0
                  if [ "$status" -eq 0 ]; then
                    locked=1
                    locked_target=$buffer
                    locked_command=$CMDABC_DEL_COMMAND
                    locked_raw=$CMDABC_DEL_RAW
                    locked_snapshot=$CMDABC_DEL_LIBRARY_SNAPSHOT
                    error_kind=''
                    error=''
                  elif [ -n "$CMDABC_INVALID_REASON" ]; then
                    error_kind=invalid
                    error=$CMDABC_INVALID_REASON
                  else
                    error_kind=error
                    error=${CMDABC_ERROR_REASON:-command library is not readable}
                  fi
                else
                  before=${buffer:0:$cursor}
                  after=${buffer:$cursor}
                  buffer=$before$CMDABC_PASTE_TEXT$after
                  cursor=$((cursor + ${#CMDABC_PASTE_TEXT}))
                  error_kind=''
                  error=''
                fi
            fi
            ;;
        esac
        ;;
      *)
        before=${buffer:0:$cursor}
        after=${buffer:$cursor}
        buffer=$before$key$after
        cursor=$((cursor + ${#key}))
        error_kind=''
        error=''
        ;;
    esac
  done
}

cmdabc_list_display_path() {
  CMDABC_LIST_DISPLAY_PATH='~/.cmdabc-data/command-library.txt'
}

cmdabc_list_add_row() {
  local text=$1
  local style=$2
  local index=${#CMDABC_LIST_ROWS[@]}

  CMDABC_LIST_ROWS[$index]=$text
  CMDABC_LIST_STYLES[$index]=$style
}

cmdabc_build_list_rows() {
  local library=$1
  local index label error command row padding width
  local valid_count=0 invalid_count=0 max_label=0

  cmdabc_load_library "$library" tolerant || return $?
  cmdabc_list_display_path "$library"
  CMDABC_LIST_ROWS=()
  CMDABC_LIST_STYLES=()

  index=0
  while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
    if [ "${CMDABC_RECORD_VALID[$index]}" -eq 1 ]; then
      valid_count=$((valid_count + 1))
      label=${CMDABC_RECORD_PATHS[$index]}
    else
      invalid_count=$((invalid_count + 1))
      label=${CMDABC_RECORD_LABELS[$index]}
      [ -n "$label" ] || label="line ${CMDABC_RECORD_LINES[$index]}"
    fi
    [ "${#label}" -le "$max_label" ] || max_label=${#label}
    index=$((index + 1))
  done

  index=0
  while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
    label=${CMDABC_RECORD_LABELS[$index]}
    [ -n "$label" ] || label="line ${CMDABC_RECORD_LINES[$index]}"
    padding=''
    width=$((${#label}))
    while [ "$width" -lt "$max_label" ]; do
      padding=$padding' '
      width=$((width + 1))
    done
    if [ "${CMDABC_RECORD_VALID[$index]}" -eq 1 ]; then
      command=${CMDABC_RECORD_COMMANDS[$index]}
      row="$label$padding  $command"
      cmdabc_list_add_row "$row" normal
    else
      error=${CMDABC_RECORD_ERRORS[$index]}
      cmdabc_user_reason "$error"
      error=$CMDABC_USER_REASON
      row="$label$padding  [invalid: $error]"
      cmdabc_list_add_row "$row" invalid
    fi
    index=$((index + 1))
  done

  CMDABC_LIST_VALID_COUNT=$valid_count
  CMDABC_LIST_INVALID_COUNT=$invalid_count
}

cmdabc_truncate_list_text() {
  local text=$1
  local width=$2

  CMDABC_LIST_RENDER_TEXT=$text
  if [ "${#CMDABC_LIST_RENDER_TEXT}" -gt "$width" ]; then
    if [ "$width" -gt 1 ]; then
      CMDABC_LIST_RENDER_TEXT=${CMDABC_LIST_RENDER_TEXT:0:$((width - 1))}'…'
    else
      CMDABC_LIST_RENDER_TEXT=${CMDABC_LIST_RENDER_TEXT:0:1}
    fi
  fi
}

cmdabc_render_list() {
  local offset=$1
  local columns lines content_width capacity index end style

  columns=${COLUMNS:-80}
  case "$columns" in
    ''|*[!0-9]*|0) columns=80 ;;
  esac
  lines=${LINES:-24}
  case "$lines" in
    ''|*[!0-9]*|0) lines=24 ;;
  esac
  [ "$lines" -ge 8 ] || lines=8
  content_width=$((10#$columns - 1))
  [ "$content_width" -ge 1 ] || content_width=1
  capacity=$((10#$lines - 6))
  [ "$capacity" -ge 1 ] || capacity=1
  end=$((offset + capacity))

  cmdabc_truncate_list_text "$CMDABC_LIST_DISPLAY_PATH" "$content_width"
  printf '\033[H\033[2JCommands\n\033[2m%s\033[0m\n\n' \
    "$CMDABC_LIST_RENDER_TEXT" >&4
  index=$offset
  while [ "$index" -lt "$end" ] && [ "$index" -lt "${#CMDABC_LIST_ROWS[@]}" ]; do
    cmdabc_truncate_list_text "${CMDABC_LIST_ROWS[$index]}" "$content_width"
    style=${CMDABC_LIST_STYLES[$index]}
    case "$style" in
      invalid) printf '\033[31m%s\033[0m\n' "$CMDABC_LIST_RENDER_TEXT" >&4 ;;
      *) printf '%s\n' "$CMDABC_LIST_RENDER_TEXT" >&4 ;;
    esac
    index=$((index + 1))
  done
  printf '\033[%s;1H%s valid   ' "$((lines - 2))" "$CMDABC_LIST_VALID_COUNT" >&4
  if [ "$CMDABC_LIST_INVALID_COUNT" -gt 0 ]; then
    printf '\033[31m%s invalid\033[0m' "$CMDABC_LIST_INVALID_COUNT" >&4
  else
    printf '%s invalid' "$CMDABC_LIST_INVALID_COUNT" >&4
  fi
  printf '\033[%s;1H↑/↓ scroll   Esc back' "$lines" >&4
}

cmdabc_list_editor() {
  local library=$1
  local offset=0 key='' status lines capacity max_offset

  CMDABC_ERROR_REASON=''
  CMDABC_DEFER_ERRORS=1
  if cmdabc_build_list_rows "$library"; then
    status=0
  else
    status=$?
  fi
  CMDABC_DEFER_ERRORS=0
  if [ "$status" -ne 0 ]; then
    CMDABC_LIST_FAILURE_MESSAGE="[error: ${CMDABC_ERROR_REASON:-command library is not readable}]"
    return 11
  fi

  lines=${LINES:-24}
  case "$lines" in
    ''|*[!0-9]*|0) lines=24 ;;
  esac
  [ "$lines" -ge 8 ] || lines=8
  capacity=$((10#$lines - 6))
  [ "$capacity" -ge 1 ] || capacity=1
  max_offset=$((${#CMDABC_LIST_ROWS[@]} - capacity))
  [ "$max_offset" -ge 0 ] || max_offset=0

  while :; do
    cmdabc_render_list "$offset"
    key=''
    if cmdabc_read_tty_byte; then
      key=$CMDABC_TTY_BYTE
    else
      CMDABC_LIST_FAILURE_MESSAGE='[error: terminal input failed]'
      return 11
    fi
    case "$key" in
      $'\033')
        if ! cmdabc_read_escape_sequence; then
          return 10
        fi
        case "$CMDABC_ESCAPE_SEQUENCE" in
          '[A') [ "$offset" -le 0 ] || offset=$((offset - 1)) ;;
          '[B') [ "$offset" -ge "$max_offset" ] || offset=$((offset + 1)) ;;
        esac
        ;;
    esac
  done
}

cmdabc_append_visible_children() {
  local parent=$1
  local depth=$2
  local expanded_path=$3
  local index child_path is_expanded
  local -a child_names child_types child_commands child_valid child_lines
  local -a child_raw child_errors

  cmdabc_build_children "$parent"
  child_names=("${CMDABC_CHILD_NAMES[@]}")
  child_types=("${CMDABC_CHILD_TYPES[@]}")
  child_commands=("${CMDABC_CHILD_COMMANDS[@]}")
  child_valid=("${CMDABC_CHILD_VALID[@]}")
  child_lines=("${CMDABC_CHILD_LINES[@]}")
  child_raw=("${CMDABC_CHILD_RAW[@]}")
  child_errors=("${CMDABC_CHILD_ERRORS[@]}")

  index=0
  while [ "$index" -lt "${#child_names[@]}" ]; do
    child_path="$parent.${child_names[$index]}"
    is_expanded=0
    if [ "${child_types[$index]}" = "parent" ]; then
      case "$expanded_path" in
        "$child_path"|"$child_path".*) is_expanded=1 ;;
      esac
    fi

    CMDABC_VISIBLE_NAMES[${#CMDABC_VISIBLE_NAMES[@]}]=${child_names[$index]}
    CMDABC_VISIBLE_TYPES[${#CMDABC_VISIBLE_TYPES[@]}]=${child_types[$index]}
    CMDABC_VISIBLE_COMMANDS[${#CMDABC_VISIBLE_COMMANDS[@]}]=${child_commands[$index]}
    CMDABC_VISIBLE_VALID[${#CMDABC_VISIBLE_VALID[@]}]=${child_valid[$index]}
    CMDABC_VISIBLE_LINES[${#CMDABC_VISIBLE_LINES[@]}]=${child_lines[$index]}
    CMDABC_VISIBLE_RAW[${#CMDABC_VISIBLE_RAW[@]}]=${child_raw[$index]}
    CMDABC_VISIBLE_ERRORS[${#CMDABC_VISIBLE_ERRORS[@]}]=${child_errors[$index]}
    CMDABC_VISIBLE_PATHS[${#CMDABC_VISIBLE_PATHS[@]}]=$child_path
    CMDABC_VISIBLE_DEPTHS[${#CMDABC_VISIBLE_DEPTHS[@]}]=$depth
    CMDABC_VISIBLE_EXPANDED[${#CMDABC_VISIBLE_EXPANDED[@]}]=$is_expanded

    if [ "$is_expanded" -eq 1 ]; then
      cmdabc_append_visible_children "$child_path" "$((depth + 1))" "$expanded_path"
    fi
    index=$((index + 1))
  done
}

cmdabc_build_visible() {
  local namespace=$1
  local expanded_path=$2

  CMDABC_VISIBLE_NAMES=()
  CMDABC_VISIBLE_TYPES=()
  CMDABC_VISIBLE_COMMANDS=()
  CMDABC_VISIBLE_VALID=()
  CMDABC_VISIBLE_LINES=()
  CMDABC_VISIBLE_RAW=()
  CMDABC_VISIBLE_ERRORS=()
  CMDABC_VISIBLE_PATHS=()
  CMDABC_VISIBLE_DEPTHS=()
  CMDABC_VISIBLE_EXPANDED=()
  cmdabc_append_visible_children "$namespace" 0 "$expanded_path"
}

cmdabc_find_visible_index() {
  local wanted_path=$1
  local index=0

  CMDABC_VISIBLE_INDEX=-1
  while [ "$index" -lt "${#CMDABC_VISIBLE_PATHS[@]}" ]; do
    if [ "${CMDABC_VISIBLE_PATHS[$index]}" = "$wanted_path" ]; then
      CMDABC_VISIBLE_INDEX=$index
      return 0
    fi
    index=$((index + 1))
  done
  return 1
}

cmdabc_render() {
  local namespace=$1
  local selected=$2
  local index marker suffix indent depth name command preview preview_sgr gap
  local name_padding name_width
  local columns content_width row_width available preview_chars

  columns=${COLUMNS:-80}
  case "$columns" in
    ''|*[!0-9]*|0) columns=80 ;;
  esac
  content_width=$((10#$columns - 1))
  [ "$content_width" -ge 1 ] || content_width=1
  gap='  '

  printf '\033[H\033[2J' >&4
  printf 'CmdABC  /%s.\n\n' "$namespace" >&4
  index=0
  while [ "$index" -lt "${#CMDABC_VISIBLE_NAMES[@]}" ]; do
    indent=''
    depth=${CMDABC_VISIBLE_DEPTHS[$index]}
    while [ "$depth" -gt 0 ]; do
      indent="$indent  "
      depth=$((depth - 1))
    done
    marker='  '
    [ "$index" -eq "$selected" ] && marker='> '
    suffix=''
    if [ "${CMDABC_VISIBLE_TYPES[$index]}" = "parent" ]; then
      if [ "${CMDABC_VISIBLE_EXPANDED[$index]}" -eq 1 ]; then
        suffix=' ▾'
      else
        suffix=' ▸'
      fi
    fi
    name=${CMDABC_VISIBLE_NAMES[$index]}
    name_padding=''
    if [ "$namespace" = abc ] && [ "${CMDABC_VISIBLE_TYPES[$index]}" = leaf ]; then
      name_width=${#name}
      while [ "$name_width" -lt 4 ]; do
        name_padding=$name_padding' '
        name_width=$((name_width + 1))
      done
    fi
    printf '%s%s%s%s%s' "$indent" "$marker" "$name" "$suffix" "$name_padding" >&4
    if [ "${CMDABC_VISIBLE_TYPES[$index]}" = "leaf" ]; then
      if [ "${CMDABC_VISIBLE_VALID[$index]}" -eq 1 ]; then
        command=${CMDABC_VISIBLE_COMMANDS[$index]}
        preview=$command
        if [ "$namespace" = abc ]; then
          preview_sgr='2'
        else
          preview_sgr='2;3'
        fi
      else
        preview='???'
        preview_sgr='2'
      fi
      row_width=$((${#indent} + ${#marker} + ${#name} + ${#suffix} + ${#name_padding}))
      available=$((content_width - row_width - ${#gap}))
      if [ "$available" -ge 8 ]; then
        if [ "${#preview}" -gt "$available" ]; then
          preview_chars=$((available - 1))
          preview=${preview:0:preview_chars}'…'
        fi
        printf '%s\033[%sm%s\033[0m' "$gap" "$preview_sgr" "$preview" >&4
      fi
    fi
    printf '\n' >&4
    index=$((index + 1))
  done
  printf '\n↑/↓ select   Enter/Right open   Left back   Esc cancel' >&4
}

CMDABC_INPUT_QUEUE=''
CMDABC_ESCAPE_DSR_PENDING=0

cmdabc_read_tty_byte() {
  local __cmdabc_byte

  if [ -n "$CMDABC_INPUT_QUEUE" ]; then
    CMDABC_TTY_BYTE=${CMDABC_INPUT_QUEUE:0:1}
    CMDABC_INPUT_QUEUE=${CMDABC_INPUT_QUEUE:1}
    return 0
  fi
  __cmdabc_byte=''
  IFS= read -r -s -n 1 __cmdabc_byte <&3
  CMDABC_TTY_BYTE=$__cmdabc_byte
}

cmdabc_read_escape_byte() {
  local __cmdabc_byte

  if [ -n "$CMDABC_INPUT_QUEUE" ]; then
    CMDABC_ESCAPE_BYTE=${CMDABC_INPUT_QUEUE:0:1}
    CMDABC_INPUT_QUEUE=${CMDABC_INPUT_QUEUE:1}
    return 0
  fi
  __cmdabc_byte=''
  if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
    IFS= read -r -s -n 1 -t 0.08 __cmdabc_byte <&3
  else
    IFS= read -r -s -n 1 -t 1 __cmdabc_byte <&3
  fi
  CMDABC_ESCAPE_BYTE=$__cmdabc_byte
  [ -n "$CMDABC_ESCAPE_BYTE" ]
}

cmdabc_drain_cursor_report() {
  local initial_escape=${1:-0}
  local state=normal candidate='' queued='' key='' status has_separator=0

  if [ "$initial_escape" -eq 1 ]; then
    state=escape
    candidate=$'\033'
  fi
  while :; do
    key=''
    IFS= read -r -s -n 1 -t 1 key <&3
    status=$?
    if [ "$status" -ne 0 ]; then
      CMDABC_INPUT_QUEUE=$CMDABC_INPUT_QUEUE$queued$candidate
      CMDABC_ESCAPE_DSR_PENDING=0
      return 1
    fi
    [ -n "$key" ] || key=$'\n'
    case "$state" in
      normal)
        if [ "$key" = $'\033' ]; then
          state=escape
          candidate=$'\033'
        else
          queued=$queued$key
        fi
        ;;
      escape)
        if [ "$key" = '[' ]; then
          state=report
          candidate=$candidate$key
          has_separator=0
        else
          queued=$queued$candidate$key
          state=normal
          candidate=''
        fi
        ;;
      report)
        case "$key" in
          [0-9]) candidate=$candidate$key ;;
          ';') candidate=$candidate$key; has_separator=1 ;;
          R)
            if [ "$has_separator" -eq 1 ]; then
              CMDABC_INPUT_QUEUE=$CMDABC_INPUT_QUEUE$queued
              CMDABC_ESCAPE_DSR_PENDING=0
              return 0
            fi
            queued=$queued$candidate$key
            state=normal
            candidate=''
            ;;
          $'\033')
            queued=$queued$candidate
            state=escape
            candidate=$'\033'
            ;;
          *)
            queued=$queued$candidate$key
            state=normal
            candidate=''
            ;;
        esac
        ;;
    esac
  done
}

cmdabc_read_escape_sequence() {
  local first second fourth fifth sixth

  CMDABC_ESCAPE_SEQUENCE=''
  CMDABC_ESCAPE_DSR_PENDING=0
  if [ -n "$CMDABC_INPUT_QUEUE" ]; then
    cmdabc_read_escape_byte || return 1
  elif [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
    cmdabc_read_escape_byte || return 1
  else
    # Bash 3.2 cannot express a sub-second read timeout. A cursor-position
    # query produces an immediate ESC[row;colR sentinel for a standalone Esc;
    # queued arrow/paste suffix bytes still arrive before that response.
    printf '\033[6n' >&4
    CMDABC_ESCAPE_DSR_PENDING=1
    cmdabc_read_escape_byte || { CMDABC_ESCAPE_DSR_PENDING=0; return 1; }
    if [ "$CMDABC_ESCAPE_BYTE" = $'\033' ]; then
      cmdabc_drain_cursor_report 1
      return 1
    fi
  fi

  first=$CMDABC_ESCAPE_BYTE
  CMDABC_ESCAPE_SEQUENCE=$first
  if [ "$first" = '[' ]; then
    if cmdabc_read_escape_byte; then
      second=$CMDABC_ESCAPE_BYTE
      CMDABC_ESCAPE_SEQUENCE=$CMDABC_ESCAPE_SEQUENCE$second
      if [ "$second" = 2 ]; then
        fourth=''
        fifth=''
        sixth=''
        if cmdabc_read_escape_byte; then fourth=$CMDABC_ESCAPE_BYTE; fi
        if cmdabc_read_escape_byte; then fifth=$CMDABC_ESCAPE_BYTE; fi
        if cmdabc_read_escape_byte; then sixth=$CMDABC_ESCAPE_BYTE; fi
        CMDABC_ESCAPE_SEQUENCE=$CMDABC_ESCAPE_SEQUENCE$fourth$fifth$sixth
      fi
    fi
  fi
  if [ "$CMDABC_ESCAPE_DSR_PENDING" -eq 1 ]; then
    cmdabc_drain_cursor_report 0 || :
  fi
  return 0
}

cmdabc_finish_leaf_selection() {
  local selected=$1

  cmdabc_tty_cleanup
  trap - EXIT INT TERM HUP
  if [ "${CMDABC_VISIBLE_VALID[$selected]}" -ne 1 ]; then
    # Status 5 tells the shell widget to clear its editor buffer and present
    # this captured message on a fresh line.
    cmdabc_user_reason "${CMDABC_VISIBLE_ERRORS[$selected]}"
    printf '[invalid: %s]\n' "$CMDABC_USER_REASON"
    return 5
  fi
  printf '%s\n' "${CMDABC_VISIBLE_COMMANDS[$selected]}"
  return 0
}

cmdabc_reload_picker_library() {
  local namespace=$1
  local library=$2

  if [ "$namespace" = abc ]; then
    cmdabc_load_system_library
  else
    cmdabc_load_library "$library" tolerant
  fi
}

cmdabc_pick() {
  local namespace expanded_path selected_path selected key second third
  local type path parent_path ancestor_path status

  cmdabc_parse_args "$@" || return $?
  [ -n "$CMDABC_LIBRARY_ARG" ] || { cmdabc_error "pick requires --library"; return 2; }
  [ -n "$CMDABC_NAMESPACE_ARG" ] || { cmdabc_error "pick requires --namespace"; return 2; }
  namespace=$CMDABC_NAMESPACE_ARG
  case "$namespace" in
    *[!A-Za-z0-9_-]*) cmdabc_print_invalid 'invalid target'; return 2 ;;
  esac

  if [ "$namespace" = abc ]; then
    cmdabc_load_system_library
  else
    cmdabc_load_library "$CMDABC_LIBRARY_ARG" tolerant || return $?
  fi
  cmdabc_build_children "$namespace"
  [ "${#CMDABC_CHILD_NAMES[@]}" -gt 0 ] \
    || { cmdabc_print_invalid 'target not found'; return 3; }

  cmdabc_tty_open || return $?

  expanded_path=''
  selected_path=''
  while :; do
    cmdabc_build_visible "$namespace" "$expanded_path"
    if [ "${#CMDABC_VISIBLE_NAMES[@]}" -eq 0 ]; then
      cmdabc_tty_cleanup
      trap - EXIT INT TERM HUP
      cmdabc_print_invalid 'target not found'
      return 3
    fi
    if [ -n "$selected_path" ] && cmdabc_find_visible_index "$selected_path"; then
      selected=$CMDABC_VISIBLE_INDEX
    else
      selected=0
      selected_path=${CMDABC_VISIBLE_PATHS[0]}
    fi
    cmdabc_render "$namespace" "$selected"

    key=''
    if cmdabc_read_tty_byte; then
      key=$CMDABC_TTY_BYTE
    else
      cmdabc_tty_cleanup
      trap - EXIT INT TERM HUP
      cmdabc_error 'terminal input failed'
      return 4
    fi

    case "$key" in
      ''|$'\r'|$'\n')
        type=${CMDABC_VISIBLE_TYPES[$selected]}
        path=${CMDABC_VISIBLE_PATHS[$selected]}
        if [ "$type" = "parent" ]; then
          cmdabc_build_children "$path"
          expanded_path=$path
          selected_path="$path.${CMDABC_CHILD_NAMES[0]}"
        elif [ "$path" = 'abc.add' ]; then
          if cmdabc_add_editor "$CMDABC_LIBRARY_ARG"; then
            cmdabc_tty_cleanup
            trap - EXIT INT TERM HUP
            cmdabc_print_added "$CMDABC_ADD_RESULT_TARGET"
            return 6
          else
            status=$?
          fi
          if [ "$status" -ne 10 ]; then
            if [ "$status" -eq 11 ]; then
              cmdabc_tty_cleanup
              trap - EXIT INT TERM HUP
              printf '%s\n' "$CMDABC_ADD_FAILURE_MESSAGE"
              return 6
            fi
            cmdabc_tty_cleanup
            trap - EXIT INT TERM HUP
            return "$status"
          fi
          cmdabc_reload_picker_library "$namespace" "$CMDABC_LIBRARY_ARG" || return $?
          printf '\033[?25l' >&4
        elif [ "$path" = 'abc.del' ]; then
          if cmdabc_del_editor "$CMDABC_LIBRARY_ARG"; then
            cmdabc_tty_cleanup
            trap - EXIT INT TERM HUP
            cmdabc_print_removed "$CMDABC_DEL_RESULT_TARGET"
            return 6
          else
            status=$?
          fi
          if [ "$status" -eq 11 ]; then
            cmdabc_tty_cleanup
            trap - EXIT INT TERM HUP
            printf '%s\n' "$CMDABC_DEL_FAILURE_MESSAGE"
            return 6
          fi
          if [ "$status" -ne 10 ]; then
            cmdabc_tty_cleanup
            trap - EXIT INT TERM HUP
            return "$status"
          fi
          cmdabc_reload_picker_library "$namespace" "$CMDABC_LIBRARY_ARG" || return $?
          printf '\033[?25l' >&4
        elif [ "$path" = 'abc.list' ]; then
          if cmdabc_list_editor "$CMDABC_LIBRARY_ARG"; then
            status=0
          else
            status=$?
          fi
          if [ "$status" -eq 11 ]; then
            cmdabc_tty_cleanup
            trap - EXIT INT TERM HUP
            printf '%s\n' "$CMDABC_LIST_FAILURE_MESSAGE"
            return 6
          fi
          if [ "$status" -ne 10 ]; then
            cmdabc_tty_cleanup
            trap - EXIT INT TERM HUP
            return "$status"
          fi
          cmdabc_reload_picker_library "$namespace" "$CMDABC_LIBRARY_ARG" || return $?
          printf '\033[?25l' >&4
        else
          cmdabc_finish_leaf_selection "$selected"
          return $?
        fi
        ;;
      $'\033')
        if ! cmdabc_read_escape_sequence; then
          cmdabc_tty_cleanup
          trap - EXIT INT TERM HUP
          return 130
        fi
        case "$CMDABC_ESCAPE_SEQUENCE" in
          '[A')
            selected=$((selected - 1))
            [ "$selected" -ge 0 ] || selected=$((${#CMDABC_VISIBLE_NAMES[@]} - 1))
            selected_path=${CMDABC_VISIBLE_PATHS[$selected]}
            ;;
          '[B')
            selected=$((selected + 1))
            [ "$selected" -lt "${#CMDABC_VISIBLE_NAMES[@]}" ] || selected=0
            selected_path=${CMDABC_VISIBLE_PATHS[$selected]}
            ;;
          '[C')
            type=${CMDABC_VISIBLE_TYPES[$selected]}
            path=${CMDABC_VISIBLE_PATHS[$selected]}
            if [ "$type" = "parent" ]; then
              cmdabc_build_children "$path"
              expanded_path=$path
              selected_path="$path.${CMDABC_CHILD_NAMES[0]}"
            elif [ "$path" = 'abc.add' ]; then
              if cmdabc_add_editor "$CMDABC_LIBRARY_ARG"; then
                cmdabc_tty_cleanup
                trap - EXIT INT TERM HUP
                cmdabc_print_added "$CMDABC_ADD_RESULT_TARGET"
                return 6
              else
                status=$?
              fi
              if [ "$status" -ne 10 ]; then
                if [ "$status" -eq 11 ]; then
                  cmdabc_tty_cleanup
                  trap - EXIT INT TERM HUP
                  printf '%s\n' "$CMDABC_ADD_FAILURE_MESSAGE"
                  return 6
                fi
                cmdabc_tty_cleanup
                trap - EXIT INT TERM HUP
                return "$status"
              fi
              cmdabc_reload_picker_library "$namespace" "$CMDABC_LIBRARY_ARG" || return $?
              printf '\033[?25l' >&4
            elif [ "$path" = 'abc.del' ]; then
              if cmdabc_del_editor "$CMDABC_LIBRARY_ARG"; then
                cmdabc_tty_cleanup
                trap - EXIT INT TERM HUP
                cmdabc_print_removed "$CMDABC_DEL_RESULT_TARGET"
                return 6
              else
                status=$?
              fi
              if [ "$status" -eq 11 ]; then
                cmdabc_tty_cleanup
                trap - EXIT INT TERM HUP
                printf '%s\n' "$CMDABC_DEL_FAILURE_MESSAGE"
                return 6
              fi
              if [ "$status" -ne 10 ]; then
                cmdabc_tty_cleanup
                trap - EXIT INT TERM HUP
                return "$status"
              fi
              cmdabc_reload_picker_library "$namespace" "$CMDABC_LIBRARY_ARG" || return $?
              printf '\033[?25l' >&4
            elif [ "$path" = 'abc.list' ]; then
              if cmdabc_list_editor "$CMDABC_LIBRARY_ARG"; then
                status=0
              else
                status=$?
              fi
              if [ "$status" -eq 11 ]; then
                cmdabc_tty_cleanup
                trap - EXIT INT TERM HUP
                printf '%s\n' "$CMDABC_LIST_FAILURE_MESSAGE"
                return 6
              fi
              if [ "$status" -ne 10 ]; then
                cmdabc_tty_cleanup
                trap - EXIT INT TERM HUP
                return "$status"
              fi
              cmdabc_reload_picker_library "$namespace" "$CMDABC_LIBRARY_ARG" || return $?
              printf '\033[?25l' >&4
            else
              cmdabc_finish_leaf_selection "$selected"
              return $?
            fi
            ;;
          '[D')
            if [ "${CMDABC_VISIBLE_DEPTHS[$selected]}" -gt 0 ]; then
              path=${CMDABC_VISIBLE_PATHS[$selected]}
              parent_path=${path%.*}
              ancestor_path=${parent_path%.*}
              if [ "$ancestor_path" = "$namespace" ]; then
                expanded_path=''
              else
                expanded_path=$ancestor_path
              fi
              selected_path=$parent_path
            fi
            ;;
        esac
        ;;
    esac
  done
}

case "${1:-}" in
  validate)
    shift
    cmdabc_validate "$@"
    ;;
  children)
    shift
    cmdabc_children "$@"
    ;;
  pick)
    shift
    cmdabc_pick "$@"
    ;;
  manage)
    shift
    cmdabc_manage "$@"
    ;;
  internal-list)
    shift
    cmdabc_internal_list "$@"
    ;;
  --version)
    [ -n "$CMDABC_VERSION" ] || { cmdabc_error "VERSION not found"; exit 2; }
    printf '%s\n' "$CMDABC_VERSION"
    ;;
  -h|--help|'')
    cmdabc_usage
    ;;
  *)
    cmdabc_error "unknown command: $1"
    cmdabc_usage >&2
    exit 2
    ;;
esac
