#!/usr/bin/env bash

# CmdABC runtime. It reads CommandLibrary and prints a selected command;
# it never evaluates or executes library commands.

CMDABC_SOURCE_DIR=$(cd "${BASH_SOURCE[0]%/*}" && pwd)
CMDABC_VERSION_FILE=$CMDABC_SOURCE_DIR/VERSION
if [ ! -r "$CMDABC_VERSION_FILE" ]; then
  CMDABC_VERSION_FILE=$CMDABC_SOURCE_DIR/../VERSION
fi
CMDABC_VERSION=''
if [ -r "$CMDABC_VERSION_FILE" ]; then
  IFS= read -r CMDABC_VERSION < "$CMDABC_VERSION_FILE" || CMDABC_VERSION=''
fi
unset CMDABC_SOURCE_DIR CMDABC_VERSION_FILE

cmdabc_usage() {
  printf 'CmdABC %s\n\n' "${CMDABC_VERSION:-unknown}"
  cat <<'EOF'
Commands as easy as ABC.

In an interactive Bash or zsh session:
  /abc.         Manage commands
  /git.         Open a saved command picker

Options:
  --version
  --help
EOF
}

CMDABC_ERROR_REASON=''
CMDABC_DEFER_ERRORS=0

cmdabc_error() {
  cmdabc_user_reason "$*"
  CMDABC_ERROR_REASON=$CMDABC_USER_REASON
  if [ "$CMDABC_DEFER_ERRORS" -eq 0 ]; then
    printf '[error: %s]\n' "$CMDABC_ERROR_REASON" >&2
  fi
}

cmdabc_parse_args() {
  CMDABC_LIBRARY_ARG=${CMDABC_LIBRARY:-}
  if [ -z "$CMDABC_LIBRARY_ARG" ] && [ -n "${HOME:-}" ]; then
    CMDABC_LIBRARY_ARG=$HOME/.cmdabc-data/command-library.txt
  fi
  CMDABC_PATH_ARG=""
  CMDABC_NAMESPACE_ARG=""
  CMDABC_INPUT_ARG=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --library)
        [ "$#" -ge 2 ] || { cmdabc_error "--library requires a file"; return 2; }
        CMDABC_LIBRARY_ARG=$2
        shift 2
        ;;
      --path)
        [ "$#" -ge 2 ] || { cmdabc_error "--path requires a value"; return 2; }
        CMDABC_PATH_ARG=$2
        shift 2
        ;;
      --namespace)
        [ "$#" -ge 2 ] || { cmdabc_error "--namespace requires a value"; return 2; }
        CMDABC_NAMESPACE_ARG=$2
        shift 2
        ;;
      --input)
        [ "$#" -ge 2 ] || { cmdabc_error "--input requires a value"; return 2; }
        CMDABC_INPUT_ARG=$2
        shift 2
        ;;
      *)
        cmdabc_error "unknown argument: $1"
        return 2
        ;;
    esac
  done
}

cmdabc_classify_source_line() {
  local line=$1

  CMDABC_LINE_KIND=record
  if [[ "$line" =~ ^[[:space:]]*$ ]]; then
    CMDABC_LINE_KIND=blank
  elif [[ "$line" =~ ^[[:space:]]*# ]]; then
    CMDABC_LINE_KIND=comment
  fi
}

cmdabc_load_library() {
  local library=$1
  local mode=${2:-strict}
  local line line_number path command target_error has_delimiter
  local index other count conflict prior
  local duplicate_lines
  local -a pending_paths pending_lines pending_raw pending_errors

  CMDABC_PATHS=()
  CMDABC_COMMANDS=()
  CMDABC_ENTRY_VALID=()
  CMDABC_ENTRY_LINES=()
  CMDABC_ENTRY_RAW=()
  CMDABC_ENTRY_ERRORS=()
  CMDABC_RECORD_PATHS=()
  CMDABC_RECORD_COMMANDS=()
  CMDABC_RECORD_VALID=()
  CMDABC_RECORD_LINES=()
  CMDABC_RECORD_RAW=()
  CMDABC_RECORD_ERRORS=()
  CMDABC_RECORD_LOCATABLE=()
  CMDABC_RECORD_LABELS=()

  [ -f "$library" ] || { cmdabc_error 'command library not found'; return 2; }
  [ -r "$library" ] || { cmdabc_error 'command library is not readable'; return 2; }

  line_number=0
  if ! while IFS= read -r line || [ -n "$line" ]; do
    line_number=$((line_number + 1))

    cmdabc_classify_source_line "$line"
    [ "$CMDABC_LINE_KIND" = record ] || continue

    has_delimiter=0
    case "$line" in
      *[[:space:]]*)
        has_delimiter=1
        path=${line%%[[:space:]]*}
        command=${line#"$path"}
        command=${command#?}
        ;;
      *)
        path=$line
        command=''
        ;;
    esac

    cmdabc_classify_target "$path"
    target_error=$CMDABC_TARGET_ERROR
    if [ "$has_delimiter" -eq 0 ] && [ -n "$target_error" ]; then
      target_error='malformed entry'
    elif [ -z "$target_error" ] && ! [[ "$command" =~ [^[:space:]] ]]; then
      target_error='missing command'
    fi

    index=${#CMDABC_RECORD_PATHS[@]}
    CMDABC_RECORD_PATHS[$index]=$path
    CMDABC_RECORD_COMMANDS[$index]=$command
    CMDABC_RECORD_LINES[$index]=$line_number
    CMDABC_RECORD_RAW[$index]=$line
    CMDABC_RECORD_ERRORS[$index]=$target_error
    CMDABC_RECORD_VALID[$index]=0
    CMDABC_RECORD_LOCATABLE[$index]=0
    CMDABC_RECORD_LABELS[$index]=$path
    if [ -z "$CMDABC_TARGET_ERROR" ]; then
      CMDABC_RECORD_LOCATABLE[$index]=1
    fi
    if [ "$target_error" = 'malformed entry' ]; then
      CMDABC_RECORD_LABELS[$index]=''
    fi
  done < "$library" 2>/dev/null; then
    cmdabc_error 'command library is not readable'
    return 2
  fi

  # A repeated target is ambiguous. Mark every occurrence and exclude all of
  # them from the executable tree instead of silently choosing the first.
  index=0
  while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
    if [ "${CMDABC_RECORD_LOCATABLE[$index]}" -eq 1 ]; then
      path=${CMDABC_RECORD_PATHS[$index]}
      count=0
      duplicate_lines=''
      other=0
      while [ "$other" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
        if [ "${CMDABC_RECORD_LOCATABLE[$other]}" -eq 1 ] \
          && [ "${CMDABC_RECORD_PATHS[$other]}" = "$path" ]; then
          count=$((count + 1))
          if [ -z "$duplicate_lines" ]; then
            duplicate_lines=${CMDABC_RECORD_LINES[$other]}
          elif [ "$count" -eq 2 ]; then
            duplicate_lines="$duplicate_lines and ${CMDABC_RECORD_LINES[$other]}"
          else
            duplicate_lines="$duplicate_lines, ${CMDABC_RECORD_LINES[$other]}"
          fi
        fi
        other=$((other + 1))
      done
      if [ "$count" -gt 1 ]; then
        CMDABC_RECORD_ERRORS[$index]='duplicate target'
      fi
    fi
    index=$((index + 1))
  done

  # Two valid commands cannot make the same node both a leaf and a parent.
  index=0
  while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
    if [ -z "${CMDABC_RECORD_ERRORS[$index]}" ]; then
      path=${CMDABC_RECORD_PATHS[$index]}
      other=0
      while [ "$other" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
        if [ "$other" -ne "$index" ] && [ -z "${CMDABC_RECORD_ERRORS[$other]}" ]; then
          prior=${CMDABC_RECORD_PATHS[$other]}
          case "$prior" in
            "$path".*)
              CMDABC_RECORD_ERRORS[$index]='invalid target'
              CMDABC_RECORD_ERRORS[$other]='invalid target'
              ;;
          esac
          case "$path" in
            "$prior".*)
              CMDABC_RECORD_ERRORS[$index]='invalid target'
              CMDABC_RECORD_ERRORS[$other]='invalid target'
              ;;
          esac
        fi
        other=$((other + 1))
      done
    fi
    index=$((index + 1))
  done

  index=0
  while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
    if [ -z "${CMDABC_RECORD_ERRORS[$index]}" ]; then
      CMDABC_RECORD_VALID[$index]=1
      CMDABC_PATHS[${#CMDABC_PATHS[@]}]=${CMDABC_RECORD_PATHS[$index]}
      CMDABC_COMMANDS[${#CMDABC_COMMANDS[@]}]=${CMDABC_RECORD_COMMANDS[$index]}
      CMDABC_ENTRY_VALID[${#CMDABC_ENTRY_VALID[@]}]=1
      CMDABC_ENTRY_LINES[${#CMDABC_ENTRY_LINES[@]}]=${CMDABC_RECORD_LINES[$index]}
      CMDABC_ENTRY_RAW[${#CMDABC_ENTRY_RAW[@]}]=${CMDABC_RECORD_RAW[$index]}
      CMDABC_ENTRY_ERRORS[${#CMDABC_ENTRY_ERRORS[@]}]=''
    elif [ "${CMDABC_RECORD_ERRORS[$index]}" = 'missing command' ] \
      && [ "${CMDABC_RECORD_LOCATABLE[$index]}" -eq 1 ]; then
      pending_paths[${#pending_paths[@]}]=${CMDABC_RECORD_PATHS[$index]}
      pending_lines[${#pending_lines[@]}]=${CMDABC_RECORD_LINES[$index]}
      pending_raw[${#pending_raw[@]}]=${CMDABC_RECORD_RAW[$index]}
      pending_errors[${#pending_errors[@]}]=${CMDABC_RECORD_ERRORS[$index]}
    fi
    index=$((index + 1))
  done

  if [ "$mode" = strict ]; then
    index=0
    while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
      if [ "${CMDABC_RECORD_VALID[$index]}" -ne 1 ]; then
        cmdabc_print_invalid "${CMDABC_RECORD_ERRORS[$index]}"
        return 2
      fi
      index=$((index + 1))
    done
    return 0
  fi

  # Locatable missing-command records remain visible as invalid tree leaves,
  # unless they would shadow a usable command or namespace.
  index=0
  while [ "$index" -lt "${#pending_paths[@]}" ]; do
    path=${pending_paths[$index]}
    conflict=0
    for prior in "${CMDABC_PATHS[@]}"; do
      case "$prior" in
        "$path"|"$path".*) conflict=1; break ;;
      esac
      case "$path" in
        "$prior".*) conflict=1; break ;;
      esac
    done
    if [ "$conflict" -eq 0 ]; then
      CMDABC_PATHS[${#CMDABC_PATHS[@]}]=$path
      CMDABC_COMMANDS[${#CMDABC_COMMANDS[@]}]=''
      CMDABC_ENTRY_VALID[${#CMDABC_ENTRY_VALID[@]}]=0
      CMDABC_ENTRY_LINES[${#CMDABC_ENTRY_LINES[@]}]=${pending_lines[$index]}
      CMDABC_ENTRY_RAW[${#CMDABC_ENTRY_RAW[@]}]=${pending_raw[$index]}
      CMDABC_ENTRY_ERRORS[${#CMDABC_ENTRY_ERRORS[@]}]=${pending_errors[$index]}
    fi
    index=$((index + 1))
  done
}

cmdabc_load_system_library() {
  CMDABC_PATHS=(
    abc.add
    abc.del
    abc.list
  )
  CMDABC_COMMANDS=(
    'Add a command'
    'Remove a command'
    'View commands and errors'
  )
  CMDABC_ENTRY_VALID=(1 1 1)
  CMDABC_ENTRY_LINES=(0 0 0)
  CMDABC_ENTRY_RAW=('' '' '')
  CMDABC_ENTRY_ERRORS=('' '' '')
}

cmdabc_build_children() {
  local parent=$1
  local index path remainder name child_index seen

  CMDABC_CHILD_NAMES=()
  CMDABC_CHILD_TYPES=()
  CMDABC_CHILD_COMMANDS=()
  CMDABC_CHILD_VALID=()
  CMDABC_CHILD_LINES=()
  CMDABC_CHILD_RAW=()
  CMDABC_CHILD_ERRORS=()

  index=0
  while [ "$index" -lt "${#CMDABC_PATHS[@]}" ]; do
    path=${CMDABC_PATHS[$index]}
    case "$path" in
      "$parent".*)
        remainder=${path#"$parent".}
        name=${remainder%%.*}
        seen=0
        child_index=0
        while [ "$child_index" -lt "${#CMDABC_CHILD_NAMES[@]}" ]; do
          if [ "${CMDABC_CHILD_NAMES[$child_index]}" = "$name" ]; then
            seen=1
            break
          fi
          child_index=$((child_index + 1))
        done
        if [ "$seen" -eq 0 ]; then
          CMDABC_CHILD_NAMES[${#CMDABC_CHILD_NAMES[@]}]=$name
          if [ "$remainder" = "$name" ]; then
            CMDABC_CHILD_TYPES[${#CMDABC_CHILD_TYPES[@]}]="leaf"
            CMDABC_CHILD_COMMANDS[${#CMDABC_CHILD_COMMANDS[@]}]=${CMDABC_COMMANDS[$index]}
            CMDABC_CHILD_VALID[${#CMDABC_CHILD_VALID[@]}]=${CMDABC_ENTRY_VALID[$index]}
            CMDABC_CHILD_LINES[${#CMDABC_CHILD_LINES[@]}]=${CMDABC_ENTRY_LINES[$index]}
            CMDABC_CHILD_RAW[${#CMDABC_CHILD_RAW[@]}]=${CMDABC_ENTRY_RAW[$index]}
            CMDABC_CHILD_ERRORS[${#CMDABC_CHILD_ERRORS[@]}]=${CMDABC_ENTRY_ERRORS[$index]}
          else
            CMDABC_CHILD_TYPES[${#CMDABC_CHILD_TYPES[@]}]="parent"
            CMDABC_CHILD_COMMANDS[${#CMDABC_CHILD_COMMANDS[@]}]=""
            CMDABC_CHILD_VALID[${#CMDABC_CHILD_VALID[@]}]=1
            CMDABC_CHILD_LINES[${#CMDABC_CHILD_LINES[@]}]=0
            CMDABC_CHILD_RAW[${#CMDABC_CHILD_RAW[@]}]=''
            CMDABC_CHILD_ERRORS[${#CMDABC_CHILD_ERRORS[@]}]=''
          fi
        fi
        ;;
    esac
    index=$((index + 1))
  done
}

cmdabc_validate() {
  cmdabc_parse_args "$@" || return $?
  [ -n "$CMDABC_LIBRARY_ARG" ] || { cmdabc_error "validate requires --library"; return 2; }
  cmdabc_load_library "$CMDABC_LIBRARY_ARG" || return $?
  printf 'OK: %s command records\n' "${#CMDABC_PATHS[@]}"
}

cmdabc_children() {
  local index
  cmdabc_parse_args "$@" || return $?
  [ -n "$CMDABC_LIBRARY_ARG" ] || { cmdabc_error "children requires --library"; return 2; }
  [ -n "$CMDABC_PATH_ARG" ] || { cmdabc_error "children requires --path"; return 2; }
  case "$CMDABC_PATH_ARG" in
    abc|abc.*) cmdabc_load_system_library ;;
    *) cmdabc_load_library "$CMDABC_LIBRARY_ARG" tolerant || return $? ;;
  esac
  cmdabc_build_children "$CMDABC_PATH_ARG"
  [ "${#CMDABC_CHILD_NAMES[@]}" -gt 0 ] \
    || { cmdabc_print_invalid 'target not found'; return 3; }

  index=0
  while [ "$index" -lt "${#CMDABC_CHILD_NAMES[@]}" ]; do
    printf '%s\t%s\t%s\n' \
      "${CMDABC_CHILD_NAMES[$index]}" \
      "${CMDABC_CHILD_TYPES[$index]}" \
      "${CMDABC_CHILD_COMMANDS[$index]}"
    index=$((index + 1))
  done
}

CMDABC_WRITE_TEMP=''

cmdabc_write_cleanup() {
  if [ -n "$CMDABC_WRITE_TEMP" ] && [ -e "$CMDABC_WRITE_TEMP" ]; then
    rm -f "$CMDABC_WRITE_TEMP"
  fi
}

cmdabc_abort_write() {
  cmdabc_write_cleanup
  CMDABC_WRITE_TEMP=''
  trap - EXIT INT TERM HUP
}

cmdabc_read_file_exact() {
  local output_name=$1
  local path=$2
  local value

  value=$({ cat "$path" || exit 1; printf '\001'; } 2>/dev/null) || return 1
  value=${value%$'\001'}
  printf -v "$output_name" '%s' "$value"
}

cmdabc_validate_user_target() {
  local target=$1

  cmdabc_classify_target "$target"
  [ -z "$CMDABC_TARGET_ERROR" ] || return 2
}

cmdabc_classify_target() {
  local target=$1

  CMDABC_TARGET_ERROR=''
  [ -n "$target" ] || { CMDABC_TARGET_ERROR='invalid target'; return 0; }
  case "$target" in
    .*|*.|*..*) CMDABC_TARGET_ERROR='empty namespace segment'; return 0 ;;
    abc|abc.*) CMDABC_TARGET_ERROR='reserved namespace'; return 0 ;;
    *[!A-Za-z0-9_.-]*) CMDABC_TARGET_ERROR='unsupported target character'; return 0 ;;
  esac
  case "$target" in
    *.*) ;;
    *) CMDABC_TARGET_ERROR='invalid target'; return 0 ;;
  esac
  if ! [[ "$target" =~ ^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+$ ]]; then
    CMDABC_TARGET_ERROR='unsupported target character'
  fi
}

cmdabc_print_invalid() {
  cmdabc_user_reason "$1"
  printf '[invalid: %s]\n' "$CMDABC_USER_REASON" >&2
}

cmdabc_user_reason() {
  case "$1" in
    'duplicate target') CMDABC_USER_REASON='name taken' ;;
    'invalid target') CMDABC_USER_REASON='invalid name' ;;
    'target not found') CMDABC_USER_REASON='name not found' ;;
    'unsupported target character') CMDABC_USER_REASON='unsupported name character' ;;
    'empty namespace segment') CMDABC_USER_REASON='empty name segment' ;;
    'press Space to confirm target') CMDABC_USER_REASON='press Space to confirm name' ;;
    'failed to remove target') CMDABC_USER_REASON='failed to remove name' ;;
    *) CMDABC_USER_REASON=$1 ;;
  esac
}

cmdabc_find_path_index() {
  local wanted=$1
  local index=0

  CMDABC_FOUND_INDEX=-1
  while [ "$index" -lt "${#CMDABC_PATHS[@]}" ]; do
    if [ "${CMDABC_PATHS[$index]}" = "$wanted" ]; then
      CMDABC_FOUND_INDEX=$index
      return 0
    fi
    index=$((index + 1))
  done
  return 1
}

cmdabc_check_new_target() {
  local target=$1
  local index prior

  index=0
  while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
    if [ "${CMDABC_RECORD_LOCATABLE[$index]}" -ne 1 ]; then
      index=$((index + 1))
      continue
    fi
    prior=${CMDABC_RECORD_PATHS[$index]}
    if [ "$prior" = "$target" ]; then
      CMDABC_INVALID_REASON='duplicate target'
      return 3
    fi
    case "$prior" in
      "$target".*)
        CMDABC_INVALID_REASON='invalid target'
        return 3
        ;;
    esac
    case "$target" in
      "$prior".*)
        CMDABC_INVALID_REASON='invalid target'
        return 3
        ;;
    esac
    index=$((index + 1))
  done
}

cmdabc_prepare_write_temp() {
  local library=$1
  local failure_reason=${2:-failed to update command library}
  local parent=${library%/*}

  [ ! -L "$library" ] || { cmdabc_error 'command library is not writable'; return 2; }
  [ -f "$library" ] || { cmdabc_error 'command library not found'; return 2; }
  [ -r "$library" ] || { cmdabc_error 'command library is not readable'; return 2; }
  [ -w "$library" ] || { cmdabc_error 'command library is not writable'; return 2; }
  [ -d "$parent" ] && [ -w "$parent" ] \
    || { cmdabc_error 'command library is not writable'; return 2; }

  CMDABC_WRITE_TEMP=$library.cmdabc.$$
  if [ -e "$CMDABC_WRITE_TEMP" ] || [ -L "$CMDABC_WRITE_TEMP" ]; then
    cmdabc_error "$failure_reason"
    CMDABC_WRITE_TEMP=''
    return 2
  fi
  cp -p "$library" "$CMDABC_WRITE_TEMP" 2>/dev/null \
    || { cmdabc_error "$failure_reason"; cmdabc_abort_write; return 2; }
  trap 'cmdabc_write_cleanup; exit 130' INT TERM HUP
  trap 'cmdabc_write_cleanup' EXIT
}

cmdabc_commit_write_temp() {
  local library=$1
  local failure_reason=${2:-failed to update command library}
  local status

  if cmdabc_load_library "$CMDABC_WRITE_TEMP" tolerant; then
    :
  else
    status=$?
    cmdabc_abort_write
    return "$status"
  fi
  mv -f "$CMDABC_WRITE_TEMP" "$library" 2>/dev/null \
    || { cmdabc_error "$failure_reason"; cmdabc_abort_write; return 2; }
  CMDABC_WRITE_TEMP=''
  trap - EXIT INT TERM HUP
}

cmdabc_add_record() {
  local library=$1
  local target=$2
  local command=$3
  local content

  CMDABC_INVALID_REASON=''
  cmdabc_validate_user_target "$target" \
    || { CMDABC_INVALID_REASON=$CMDABC_TARGET_ERROR; return 2; }
  [[ "$command" =~ [^[:space:]] ]] \
    || { CMDABC_INVALID_REASON='missing command'; return 2; }
  cmdabc_load_library "$library" tolerant || return $?
  cmdabc_check_new_target "$target" || return $?
  cmdabc_prepare_write_temp "$library" 'failed to update command library' || return $?
  cmdabc_read_file_exact content "$library" \
    || { cmdabc_error 'command library is not readable'; cmdabc_abort_write; return 2; }
  if [ -n "$content" ] && [[ "$content" != *$'\n' ]]; then
    printf '\n' >> "$CMDABC_WRITE_TEMP" 2>/dev/null \
      || { cmdabc_error 'failed to update command library'; cmdabc_abort_write; return 2; }
  fi
  printf '%s %s\n' "$target" "$command" >> "$CMDABC_WRITE_TEMP" 2>/dev/null \
    || { cmdabc_error 'failed to update command library'; cmdabc_abort_write; return 2; }
  cmdabc_commit_write_temp "$library" 'failed to update command library' || return $?
  CMDABC_ADDED_TARGET=$target
}

cmdabc_print_added() {
  local target=$1
  printf 'success, Added /%s\n' "$target"
}

cmdabc_rewrite_target() {
  local operation=$1
  local library=$2
  local target=$3
  local command=${4:-}
  local expected_raw=${5:-}
  local check_expected=${6:-0}
  local suppress_success=${7:-0}
  local failure_reason='failed to update command library'
  local line status output_line line_number index match_count target_line target_raw

  if [ "$operation" = delete ]; then
    failure_reason="failed to remove /$target"
  fi

  CMDABC_INVALID_REASON=''
  cmdabc_validate_user_target "$target" \
    || { cmdabc_print_invalid "$CMDABC_TARGET_ERROR"; return 2; }
  cmdabc_load_library "$library" tolerant || return $?
  match_count=0
  target_line=0
  target_raw=''
  index=0
  while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
    if [ "${CMDABC_RECORD_LOCATABLE[$index]}" -eq 1 ] \
      && [ "${CMDABC_RECORD_PATHS[$index]}" = "$target" ]; then
      match_count=$((match_count + 1))
      target_line=${CMDABC_RECORD_LINES[$index]}
      target_raw=${CMDABC_RECORD_RAW[$index]}
    fi
    index=$((index + 1))
  done
  if [ "$check_expected" -eq 1 ] \
    && { [ "$match_count" -ne 1 ] || [ "$target_raw" != "$expected_raw" ]; }; then
    cmdabc_error 'command library changed, retry'
    return 4
  fi
  if [ "$match_count" -gt 1 ]; then
    cmdabc_print_invalid 'duplicate target'
    return 3
  fi
  if [ "$match_count" -eq 0 ]; then
    cmdabc_print_invalid 'target not found'
    return 3
  fi
  if [ "$operation" = update ]; then
    [[ "$command" =~ [^[:space:]] ]] \
      || { cmdabc_print_invalid 'missing command'; return 2; }
  fi

  cmdabc_prepare_write_temp "$library" "$failure_reason" || return $?
  : > "$CMDABC_WRITE_TEMP" 2>/dev/null \
    || { cmdabc_error "$failure_reason"; cmdabc_abort_write; return 2; }
  line_number=0
  if ! while :; do
    line=''
    IFS= read -r line
    status=$?
    if [ "$status" -ne 0 ] && [ -z "$line" ]; then
      break
    fi
    line_number=$((line_number + 1))
    output_line=$line
    if [ "$line_number" -eq "$target_line" ]; then
      if [ "$operation" = delete ]; then
        if [ "$status" -ne 0 ]; then
          break
        fi
        continue
      fi
      output_line="$target $command"
    fi
    if [ "$status" -eq 0 ]; then
      printf '%s\n' "$output_line" >> "$CMDABC_WRITE_TEMP" 2>/dev/null \
        || { cmdabc_error "$failure_reason"; cmdabc_abort_write; return 2; }
    else
      printf '%s' "$output_line" >> "$CMDABC_WRITE_TEMP" 2>/dev/null \
        || { cmdabc_error "$failure_reason"; cmdabc_abort_write; return 2; }
      break
    fi
  done < "$library" 2>/dev/null; then
    cmdabc_error "$failure_reason"
    cmdabc_abort_write
    return 2
  fi
  cmdabc_commit_write_temp "$library" "$failure_reason" || return $?
  if [ "$suppress_success" -eq 0 ]; then
    case "$operation" in
      update) printf '[updated: /%s]\n' "$target" ;;
      delete) printf '[deleted: /%s]\n' "$target" ;;
    esac
  fi
}

cmdabc_manage_list() {
  local library=$1
  local index row label error
  local valid_count=0 invalid_count=0
  local use_color=0

  cmdabc_load_library "$library" tolerant || return $?
  [ -t 1 ] && use_color=1

  index=0
  while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
    if [ "${CMDABC_RECORD_VALID[$index]}" -eq 1 ]; then
      valid_count=$((valid_count + 1))
    else
      invalid_count=$((invalid_count + 1))
    fi
    index=$((index + 1))
  done

  index=0
  while [ "$index" -lt "${#CMDABC_RECORD_PATHS[@]}" ]; do
    if [ "${CMDABC_RECORD_VALID[$index]}" -eq 1 ]; then
      printf '%s %s\n' \
        "${CMDABC_RECORD_PATHS[$index]}" \
        "${CMDABC_RECORD_COMMANDS[$index]}"
    else
      label=${CMDABC_RECORD_LABELS[$index]}
      error=${CMDABC_RECORD_ERRORS[$index]}
      cmdabc_user_reason "$error"
      error=$CMDABC_USER_REASON
      if [ -z "$label" ]; then
        label="line ${CMDABC_RECORD_LINES[$index]}"
      fi
      row="$label  [invalid: $error]"
      if [ "$use_color" -eq 1 ]; then
        printf '\033[31m%s\033[0m\n' "$row"
      else
        printf '%s\n' "$row"
      fi
    fi
    index=$((index + 1))
  done

  if [ "${#CMDABC_RECORD_PATHS[@]}" -gt 0 ]; then
    printf '\n'
  fi
  if [ "$invalid_count" -gt 0 ] && [ "$use_color" -eq 1 ]; then
    printf '\033[31m%s commands, %s invalid\033[0m\n' "$valid_count" "$invalid_count"
  else
    printf '%s commands, %s invalid\n' "$valid_count" "$invalid_count"
  fi
}

